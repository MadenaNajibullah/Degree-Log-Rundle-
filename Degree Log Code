  const itemHtml = i => {
    if(i.text) return `<li class="c opt">${escHtml(i.text)}</li>`;
    const kind = i.cat === 'MAND' ? 'm' : i.cat === 'FIELD' ? 'f' : 't';
    return `<li class="c ${kind}${i.prereq ? ' auto' : ''}" style="--c:${SHEET_COLORS[i.cat]}">`
         + `<span class="code">${escHtml(i.code)}</span>`
         + `<span class="ttl">${escHtml(i.title)}</span>${SHEET_NAMES[i.cat] ? `<span class="tag">${SHEET_NAMES[i.cat]}</span>` : ''}</li>`;
