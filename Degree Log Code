  <li>ERTH 570, 580, 590 and 599 can be taken more than once (one copy per term).</li>
  <li>Adding a course automatically adds any missing prerequisites earlier in your plan.</li>
  <li>🔒 Locked courses are either missing a prerequisite or aren’t offered in that term. Hover over a locked course to see why.</li>
</ul>`;
const HINT_SEASON = `<span class="hint-title">How it works</span><ul>
  <li>Field schools are listed first, followed by every other course offered this term.</li>
  <li>Spring and Summer terms are optional — add one only if you need it.</li>
  <li>ERTH 590 and 599 can be taken more than once (one copy per term).</li>
  <li>Adding a course automatically adds any missing prerequisites earlier in your plan.</li>
  <li>🔒 Locked courses are either missing a prerequisite or aren’t offered in that term. Hover over a locked course to see why.</li>
</ul>`;
let pickerYear = null, pickerTerm = null, pickerActiveTab = 'NON', pickerSeason = false;

function tabCodes(tab){
  if(tab === 'ERTH')  return MANDATORY_ERTH;
  if(tab === 'NON')   return MANDATORY_NON;
  if(tab === 'FIELD') return FIELD_CODES;
  return (TRACK_ALL_ELECTIVES[tab] || []).filter(c => c !== 'ERTH580B'); // 580B comes with 580A
}
const tabChipTrack = tab => (tab === 'ERTH' || tab === 'NON') ? 'MAND' : tab;

function openPicker(year, term){
  pickerYear = normYear(year); pickerTerm = term;
  clearPickerPending(); pickerPreview = null; renderPickerPreview();
  pickerSeason = isBridgeYear(pickerYear);
  const where = isBridgeYear(pickerYear) ? `${termLabel(term)}, ${bridgeSpan(pickerYear)}` : `${termLabel(term)}, Year ${pickerYear}`;
  document.getElementById('picker-title').innerHTML = `Add — <span>${where}</span>`;
  const valid = pickerTabList();
  if(valid.indexOf(pickerActiveTab) === -1 || isOptionTab(pickerActiveTab)) pickerActiveTab = valid[0];
  updatePickerHint();
  renderPickerTabs();
  renderPickerBody();
  document.getElementById('pickerOverlay').classList.add('open');
}
function closePicker(){ clearPickerPending(); pickerPreview = null; renderPickerPreview(); document.getElementById('pickerOverlay').classList.remove('open'); }
function switchPickerTab(t){ pickerActiveTab = t; clearPickerPending(); pickerPreview = null; renderPickerPreview(); updatePickerHint(); renderPickerTabs(); renderPickerBody(); }
const HINT_OPTION = "An open option is a blank box you type into — use it for an elective or any course that isn't listed here.";
const OPTION_TABS = ['OPTION'];   // one tab; its own sub-tabs pick the type of option
const isOptionTab = t => OPTION_TABS.indexOf(t) !== -1;
let pickerOptCat = 'science';
const OPTION_SUBTABS = ['science','nonsci','arts','gge'];
const OPTION_SUB_NAME = {open:'Open', science:'Science', nonsci:'Non-science', arts:'Non-science (Arts)', gge:'GGE'};
const OPTION_TAB_HINT = {
  open:HINT_OPTION,
  science:"A science option is any science course that isn't a required course. Type it in and enter its units so it counts toward your Science options.",
  nonsci:"A non-science option is any course outside the Faculty of Science. Type it in and enter its units so it counts toward your Non-science options.",
  arts:"A non-science (Arts) option is a course from the Faculty of Arts. Enter its units: at least 6 U of your 15 U of non-science options must be Arts.",
  gge:"A GGE option is an Earth, Engineering, Geography or Physics course that isn't listed here. Type it in and enter its units so it counts toward your GGE options."
};
function switchOptionSub(c){
  const n = document.getElementById('pk-name'), u = document.getElementById('pk-units');
  const keep = {name:n ? n.value : '', units:u ? u.value : ''};
  pickerOptCat = c; updatePickerHint(); renderPickerBody();
  const n2 = document.getElementById('pk-name'), u2 = document.getElementById('pk-units');
  if(n2) n2.value = keep.name; if(u2) u2.value = keep.units;
}
const pickerTabList = () => pickerSeason ? ['SEASON', ...OPTION_TABS] : [...PICKER_TABS, ...OPTION_TABS];
function updatePickerHint(){
  let html = isOptionTab(pickerActiveTab) ? OPTION_TAB_HINT[pickerOptCat] : (pickerSeason ? HINT_SEASON : HINT_PICKER);
  html = html.replace('Hover over a locked course to see why.', isTouchUI()
    ? 'Tap a course once to read its description (and why it is locked); tap it again, or double-tap, to add it.'
    : 'Click a course once to read its description (and why it is locked); click it again, or double-click, to add it.');
  document.getElementById('picker-hint').innerHTML = html;
}
function addOptionFromPicker(cat){
  const nameEl = document.getElementById('pk-name'), unitsEl = document.getElementById('pk-units');
  const value = nameEl ? nameEl.value.trim() : '';
  const credits = unitsEl ? unitsEl.value : '';
  if(!value){ closePicker(); addSlot(pickerYear, pickerTerm, cat); return; }   // nothing typed: add an empty box to fill in on the sheet
  const units = Math.max(0, parseFloat(credits) || 0);
  if(isJuniorText(value) && juniorUnitsNow() + (units || 3) > JUNIOR_MAX){ showToast(juniorMsg(escHtml(value)) + ' Change the course or its units.'); return; }
  const c = SLOT_CATS[cat] ? cat : 'open';
  ensureOptionSlot(pickerYear, pickerTerm).push({id:'opt'+(++slotIdCounter), label:SLOT_CATS[c], value, credits, category:c, editing:false});
  closePicker();
  renderColumn();
}

function renderPickerTabs(){
  document.getElementById('picker-tabs').innerHTML = pickerTabList().map(t =>
    `<button class="picker-tab-btn tt-${t}${t === pickerActiveTab ? ' active' : ''}" onclick="switchPickerTab('${t}')">${PICKER_TAB_NAME[t]}</button>`
  ).join('');
}

// Touch screens have no hover: there, a first tap on a picker course previews it and a second tap adds it.
const isTouchUI = () => !!(window.matchMedia && matchMedia('(hover: none)').matches);
let pickerPreview = null;

function pickerStatus(code){
  // repeatable courses are only "already added" if this very term has one
  const already = REPEATABLE.has(code) ? (plan[slotKey(pickerYear, pickerTerm)] || []).some(e => e.code === code) : isAnywhereOnSheet(code);
  const unmet = already ? [] : unmetPrereqs(code, pickerYear, pickerTerm);
  const termOk = courseTermOk(code, pickerTerm);
  const dep = already ? [] : blockedByDependents(code, pickerYear, pickerTerm);
  const juniorBlock = !already && levelOf(code) === 200 && juniorUnitsNow() + unitsOf(code) > JUNIOR_MAX;
  const locked = !already && (unmet.length > 0 || !termOk || dep.length > 0 || juniorBlock);
  const reasons = [];
  if(locked){
    if(!termOk) reasons.push(`not offered in ${termLabel(pickerTerm)} (offered ${COURSES[code].term})`);
    if(unmet.length) reasons.push(`needs ${unmet.map(clauseLabel).join(' and ')} taken in an earlier term first`);
    if(juniorBlock) reasons.push(`would go over the ${JUNIOR_MAX} U limit on 200-level courses`);
    if(dep.length) reasons.push(`${dep.map(codeLabel).join(', ')} in your plan needs it taken earlier`);
  }
  return {already, locked, reasons};
}

function renderPickerPreview(){
  document.querySelectorAll('.picker-preview').forEach(n => n.remove());
  if(!pickerPreview || !COURSES[pickerPreview]) return;
  const chip = document.querySelector(`#picker-body .chip[data-code="${pickerPreview}"]`);
  if(!chip || typeof chip.insertAdjacentElement !== 'function') return;
  const code = pickerPreview, c = COURSES[code], st = pickerStatus(code);
  const status = st.already ? (REPEATABLE.has(code) ? 'Already in this term.' : 'Already on your plan.') : st.locked ? 'Locked: ' + st.reasons.join('; ') + '.' : (isTouchUI() ? 'Tap' : 'Click') + ' it again to add it.';
  const desc = (c.description || '').trim();
  const box = document.createElement('div');
  box.className = 'picker-preview';
  box.innerHTML = `<b>${escHtml(codeLabel(code))} — ${escHtml(c.name)}</b><span class="pp-status">${escHtml(status)}</span>${desc ? `<p>${escHtml(desc)}</p>` : ''}<p class="pp-prereq"><b>Prerequisites:</b> ${escHtml((c.prereq || '').trim() || 'none')}</p>`;
  chip.insertAdjacentElement('afterend', box);   // sits right under the course button
  if(box.scrollIntoView) box.scrollIntoView({block:'nearest', behavior:'smooth'});
}

// One click/tap previews the course (after a short pause), a second one adds it, and a quick double click/tap adds it without the preview.
let pickerPending = null, pickerPendingTimer = null;
function clearPickerPending(){ clearTimeout(pickerPendingTimer); pickerPending = null; }
function highlightPicker(code){
  document.querySelectorAll('#picker-body .chip').forEach(b => b.classList.toggle('previewing', b.dataset.code === code));
}
function pickerTap(code, trk){
  const st = pickerStatus(code), addable = !st.already && !st.locked;
  if(pickerPending === code){                       // quick second tap (double tap)
    clearPickerPending();
    if(addable){ addElective(pickerYear, pickerTerm, trk, code); return; }
    pickerPreview = code; renderPickerPreview();    // can't be added: show why
    return;
  }
  clearPickerPending();
  if(pickerPreview === code){                       // second tap after the preview is showing
    if(addable) addElective(pickerYear, pickerTerm, trk, code);
    return;
  }
  if(pickerPreview && pickerPreview !== code){ pickerPreview = null; renderPickerPreview(); }   // drop the old panel straight away
  highlightPicker(code);
  pickerPending = code;
  pickerPendingTimer = setTimeout(() => { pickerPending = null; pickerPreview = code; renderPickerPreview(); }, 280);
}

function pickerChip(code, trk){
  const {already, locked, reasons} = pickerStatus(code);

  let label = code === 'ERTH580A' ? 'ERTH 580 (A + B)' : codeLabel(code), note = code === 'ERTH580A' ? 'adds 580A this Fall and 580B in the Winter after' : '';
  if(already){
    const twin = groupOf(code).find(c => c !== code && Object.values(plan).some(l => l.some(e => e.code === c)));
    label += twin ? ` ✓ via ${codeLabel(twin)}` : (REPEATABLE.has(code) ? ' ✓ this term' : ' ✓ on sheet');
  } else if(locked){
    label += ' 🔒';
    note = reasons.join('; ');
  }
  const title = courseTip(code, note);
  const cls = `chip chip-track-${shownTrack(code, trk)}${reqErthCls(code, trk)}${locked ? ' locked stripes' : ''}${pickerPreview === code ? ' previewing' : ''}`;
  const off = already || locked ? 'aria-disabled="true"' : '';   // stays clickable so the reason can be read
  return `<button class="${cls}" ${off} data-code="${code}" ${title ? `title="${escapeAttr(title)}"` : ''} onclick="pickerTap('${code}','${trk}')">${label}</button>`;
}

function renderSeasonBody(){
  const body = document.getElementById('picker-body');
  const inTerm = CODE_LIST.filter(c => courseTermOk(c, pickerTerm) && FIELD_SCHOOLS.indexOf(c) === -1).sort();
  const group = (title, codes) => codes.length
    ? `<div class="picker-level-group"><div class="picker-level-head">${title}</div><div class="chips">${codes.map(c => pickerChip(c, chipTrackFor(c))).join('')}</div></div>`
    : '';
  body.innerHTML = group('Field schools', FIELD_SCHOOLS) + group(`Offered in ${termLabel(pickerTerm)}`, inTerm);
}

function renderPickerBody(){
  if(isOptionTab(pickerActiveTab)){
    const cat = pickerOptCat;
    const enter = `onkeydown="if(event.key==='Enter'){event.preventDefault();addOptionFromPicker('${cat}')}"`;
    document.getElementById('picker-body').innerHTML =
      `<div class="picker-tabs">${OPTION_SUBTABS.map(c => `<button class="picker-tab-btn${c === cat ? ' active' : ''}" type="button" onclick="switchOptionSub('${c}')">${OPTION_SUB_NAME[c]}</button>`).join('')}</div>`
      + `<div class="slot-wrap" style="width:100%;margin-bottom:12px">`
      + `<input class="slot-input" id="pk-name" placeholder="Type your course, e.g. ERTH 304" style="flex:1 1 200px" ${enter}>`
      + `<input class="slot-credits" id="pk-units" type="number" min="0" max="12" step="0.5" placeholder="units" aria-label="Units for this course" ${enter}>`
      + `</div>`
      + `<button class="chip add-elective" type="button" onclick="addOptionFromPicker('${cat}')">+ add ${({science:'science option', nonsci:'non-science option', arts:'non-science (Arts) option', gge:'GGE option'})[cat]}</button>`;
    setTimeout(() => document.getElementById('pk-name')?.focus(), 0);
    return;
  }
  if(pickerSeason){ renderSeasonBody(); return; }
  const body = document.getElementById('picker-body');
  const codes = tabCodes(pickerActiveTab);
  if(!codes.length){
    body.innerHTML = `<p class="picker-empty">No ${PICKER_TAB_NAME[pickerActiveTab]} courses defined yet.</p>`;
    return;
  }
  // Non-ERTH courses group by subject; everything else by level.
  const bySubject = pickerActiveTab === 'NON';
  const groups = {};
  codes.forEach(c => (groups[bySubject ? subjectOf(c) : levelOf(c)] ||= []).push(c));
  const keys = Object.keys(groups).sort((a,b) => bySubject ? a.localeCompare(b) : a - b);
  const trk = tabChipTrack(pickerActiveTab);

  body.innerHTML = keys.map(key => {
    const chips = groups[key].slice().sort().map(c => pickerChip(c, trk)).join('');
    return `<div class="picker-level-group"><div class="picker-level-head">${bySubject ? key : key + '-level'}</div><div class="chips">${chips}</div></div>`;
  }).join('');
}

