/* ---------- whole-year controls ---------- */
// Marking a year completed sets its courses and open options aside (so they are not counted twice on top of the 30 U); restoring the year puts them back.
let skippedStash = {};   // "year|term" -> {plan:[...], slots:[...]}
function toggleSkipYear(y){
  let cutForCap = 0;
  if(skippedYears.has(y)){
    skippedYears.delete(y);
    ['fall','winter'].forEach(t => {
      const k = slotKey(y, t), st = skippedStash[k];
      delete skippedStash[k];
      if(!st) return;
      let jr = juniorUnitsNow();
      const back = st.plan.filter(e => {   // skip anything added elsewhere in the meantime, or that would pass the 54 U 200-level cap
        if(isAnywhereOnSheet(e.code)) return false;
        if(levelOf(e.code) === 200){ if(jr + unitsOf(e.code) > JUNIOR_MAX){ cutForCap++; return false; } jr += unitsOf(e.code); }
        return true;
      });
      const keepSlots = st.slots.filter(sl => {
        if(!isJuniorText(sl.value)) return true;
        if(jr + slotUnits(sl) > JUNIOR_MAX){ cutForCap++; return false; }
        jr += slotUnits(sl); return true;
      });
      if(back.length) plan[k] = (plan[k] || []).concat(back);
      if(keepSlots.length) optionSlots[k] = (optionSlots[k] || []).concat(keepSlots);
    });
  }else{
    skippedYears.add(y);
    ['fall','winter'].forEach(t => {
      const k = slotKey(y, t);
      const entries = plan[k] || [], slots = optionSlots[k] || [];
      if(entries.length || slots.length) skippedStash[k] = {plan:entries, slots};
      delete plan[k]; delete optionSlots[k];
    });
  }
  cascadeRemoveOrphans();
  renderColumn();
  if(cutForCap) showToast(`${cutForCap} 200-level course${cutForCap === 1 ? ' was' : 's were'} left out of the restored year: they would pass the ${JUNIOR_MAX} U limit.`);
}

// Delete a year that was marked completed: it disappears and stops counting as completed.
function deleteYear(y){
  skippedYears.add(y); deletedYears.add(y);
  // Anything still sitting in the year's terms (courses, open options) goes too, so the tracker no longer counts it.
  ['fall','winter'].forEach(t => { const k = slotKey(y, t); delete plan[k]; delete optionSlots[k]; delete skippedStash[k]; });
  tidyPlan();
  renderColumn();
}
function undeleteYear(y){
  deletedYears.delete(y); skippedYears.delete(y);
  expandedYears.add(y);   // bring the year straight back into view
  cascadeRemoveOrphans();
  renderColumn();
}

function revealYearsUpTo(n){ YEAR_ORDER.forEach(v => { if(typeof v === 'number' && v <= n) expandedYears.add(v); }); }
function addAcademicYear(){
  // Fill the lowest missing year first, whether it is hidden (collapsed) or was deleted; only then add a new one.
  const next = YEAR_ORDER.find(y => typeof y === 'number' && (isCollapsed(y) || deletedYears.has(y)));
  if(next === undefined) addExtraYear();
  else if(deletedYears.has(next)) undeleteYear(next);
  else { revealYearsUpTo(next); renderColumn(); }
  const last = YEAR_ORDER.filter(y => typeof y === 'number').pop();
  document.getElementById('yr-' + (next === undefined ? last : next))?.scrollIntoView({behavior:'smooth', block:'center'});
}

let extraYearCount = 0;
function addExtraYear(){
  const y = 4 + (++extraYearCount);
  const b = (y-1) + 's'; // the Spring/Summer break leading into the new year
  YEAR_ORDER.push(b, y);
  YEAR_TITLE[y] = 'Year ' + y;
  expandedYears.add(y);
  BRIDGE_TITLE[b] = 'Spring/Summer';
  REQUIRED[b] = {label:`break between year ${y-1} and ${y} — optional; add Spring or Summer terms if you need them`, bridge:true};
  REQUIRED[y] = {label:'electives'};
  ORDER_LIST.push({y:b,t:'spring'},{y:b,t:'summer'},{y:y,t:'fall'},{y:y,t:'winter'});
  renderColumn();
}
function removeExtraYear(){
  if(!extraYearCount) return;
  const y = 4 + extraYearCount--;
  const b = (y-1) + 's';
  [y, b].forEach(k => {
    YEAR_ORDER.splice(YEAR_ORDER.indexOf(k), 1);
    delete REQUIRED[k];
    for(let i = ORDER_LIST.length-1; i >= 0; i--) if(ORDER_LIST[i].y === k) ORDER_LIST.splice(i,1);
    ['fall','winter','spring','summer'].forEach(t => {
      const sk = slotKey(k,t);
      delete optionSlots[sk]; delete plan[sk]; delete skippedStash[sk]; addedTerms.delete(sk);
    });
  });
  delete YEAR_TITLE[y];
  delete BRIDGE_TITLE[b];
  skippedYears.delete(y); deletedYears.delete(y);
  expandedYears.delete(y);
  tidyPlan();
  renderColumn();
}

/* ---------- side nav ---------- */
function renderSideNav(){
  const nav = document.getElementById('sideNav');
  nav.innerHTML = YEAR_ORDER.filter(y => !deletedYears.has(y) && (YEAR_TITLE[y] || bridgeHasTerms(y))).map(y => {
    const label = YEAR_TITLE[y] || BRIDGE_TITLE[y];
    return `<button class="${YEAR_TITLE[y] ? '' : 'bridge'}" data-yr="${y}" onclick="jumpToYear('${y}')">${label}</button>`;
  }).join('') + `<button class="nav-progress" type="button" onclick="jumpToProgress()">Progress ↓</button>`;
}
function jumpToProgress(){ document.getElementById('tracker')?.scrollIntoView({behavior:'smooth', block:'start'}); }
function jumpToYear(y){
  y = normYear(y);
  if(isCollapsed(y)){ revealYearsUpTo(y); renderColumn(); }
  document.getElementById('yr-'+y)?.scrollIntoView({behavior:'smooth', block:'start'});
}
let navObserver = null;
function setupNavObserver(){
  if(typeof IntersectionObserver === 'undefined') return;
  navObserver?.disconnect();
  const buttons = [...document.querySelectorAll('#sideNav button')];
  navObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(!entry.isIntersecting) return;
      const y = entry.target.id.replace('yr-','');
      buttons.forEach(b => b.classList.toggle('active', b.dataset.yr === y));
    });
  }, {rootMargin:'-35% 0px -55% 0px', threshold:0});
  YEAR_ORDER.forEach(y => {
    const el = document.getElementById('yr-'+y);
    if(el && buttons.some(b => b.dataset.yr === String(y))) navObserver.observe(el);
  });
}

/* ---------- course drawer ---------- */
function linkify(text){
  // Spell out slash shorthand ("ERTH 330/360" → "ERTH 330/ERTH 360") so every course we know about gets its own link.
  text = text.replace(/\b([A-Z]{3,4}) (\d{3})((?:\/\d{3})+)/g, (m, subj, first, rest) =>
    `${subj} ${first}` + rest.split('/').slice(1).map(n => '/' + (COURSES[subj + n] ? `${subj} ${n}` : n)).join(''));
  return CODE_LIST.reduce((out, code) => {
    const spaced = codeLabel(code);
    return out.split(spaced).join(`<button class="reflink" onclick="openDrawer('${code}')">${spaced}</button>`);
  }, text);
}
// Back/forward history of the courses opened in the drawer.
let drawerHist = [], drawerPos = -1;
function drawerNav(step){
  const i = drawerPos + step;
  if(i < 0 || i >= drawerHist.length) return;
  drawerPos = i;
  openDrawer(drawerHist[i], true);
}
function updateDrawerNav(){
  const back = document.getElementById('d-back'), fwd = document.getElementById('d-fwd');
  if(!back || !fwd) return;
  back.disabled = drawerPos <= 0;
  fwd.disabled  = drawerPos >= drawerHist.length - 1;
  document.getElementById('d-pos').textContent = drawerHist.length > 1 ? `${drawerPos + 1} / ${drawerHist.length}` : '';
}
function openDrawer(code, fromNav){
  const c = COURSES[code];
  if(!c) return;
  if(!fromNav && drawerHist[drawerPos] !== code){
    drawerHist = drawerHist.slice(0, drawerPos + 1);   // a new click drops any forward history
    drawerHist.push(code);
    if(drawerHist.length > 50) drawerHist.shift();
    drawerPos = drawerHist.length - 1;
  }
  updateDrawerNav();
  document.getElementById('d-code').textContent  = codeLabel(code);
  document.getElementById('d-name').textContent  = c.name;
  document.getElementById('d-desc').textContent  = (c.description || '').trim();
  document.getElementById('d-term').textContent  = c.term;
  document.getElementById('d-units').textContent = c.units + ' units';
  document.getElementById('d-prereq').innerHTML  = linkify(c.prereq);
  document.getElementById('d-antireq').innerHTML = linkify(c.antireq);
  const others = groupOf(code).filter(c => c !== code);
  document.getElementById('d-equiv-wrap').style.display = others.length ? '' : 'none';
  const key = Object.keys(plan).find(k => plan[k].some(e => e.code === code));
  const term = key ? key.split('|')[1] : null;
  document.getElementById('d-equiv').innerHTML = others.map(o => {
    let h = `<button class="reflink" onclick="openDrawer('${o}')">${codeLabel(o)}</button>`;
    if(term) h += courseTermOk(o, term)
      ? `<button class="reflink" onclick="swapEquivalent('${code}','${o}')">use ${codeLabel(o)} instead</button>`
      : ` <i>(not offered in ${termLabel(term)})</i>`;
    return h;
  }).join(' ');
  document.getElementById('drawer').classList.add('open');
}
function swapEquivalent(code, other){
  for(const k in plan){
    const e = plan[k].find(x => x.code === code);
    if(!e) continue;
    const [sy, st] = k.split('|');
    if(!courseTermOk(other, st)) return;
    e.code = other;
    if(unsatisfiedOnSheet(other, normYear(sy), st).length){   // the other version's prerequisites aren't in place before this term
      e.code = code;
      showToast(`Can’t switch to <b>${codeLabel(other)}</b> here: its prerequisites aren’t taken in an earlier term.`);
      return;
    }
    renderColumn();
    openDrawer(other);
    return;
  }
}
function closeDrawer(){
  document.getElementById('drawer').classList.remove('open');
  drawerHist = []; drawerPos = -1;   // history starts fresh each time the drawer is closed
  updateDrawerNav();
}
document.addEventListener('keydown', e => {
  if(!e.altKey || !document.getElementById('drawer').classList.contains('open')) return;
  if(e.key === 'ArrowLeft'){ e.preventDefault(); drawerNav(-1); }
  else if(e.key === 'ArrowRight'){ e.preventDefault(); drawerNav(1); }
});

