/* ---------- prerequisites, read straight from each course's `prereq` text ----------
   Rules:
   • "/" means OR, and a bare number takes the subject of the code before it:
       "ERTH 330/360"  →  ERTH 330 or ERTH 360        "PHYS 211/221/227"  →  PHYS 211, 221 or 227
   • "or" means OR too ("GEOG 484 or 485" works like "GEOG 484 or GEOG 485"), and so does a comma list inside brackets:  "(ERTH 330/360, GLGY 401)"
   • commas, ";" and "and" outside brackets separate requirements, and ALL of those must be met.
   Result: PREREQS[code] = [ [alt, alt…], [alt…] ]  — one inner list per requirement; take at least one from each.
   Alternatives that aren't in COURSES (GLGY, GOPH, DATA, MATH 275/277, "24 units"…) are ignored, and twins
   in EQUIV_GROUPS count as one course. Edit the `prereq` text and the planner follows. */
function parsePrereqText(text, self){
  if(!text) return [];
  const parts = []; let depth = 0, cur = '';
  for(let i = 0; i < text.length; i++){
    const ch = text[i];
    if(ch === '(') depth++; else if(ch === ')') depth = Math.max(0, depth - 1);
    if(depth === 0 && (ch === ',' || ch === ';')){ parts.push(cur); cur = ''; continue; }
    if(depth === 0 && text.startsWith(' and ', i)){ parts.push(cur); cur = ''; i += 4; continue; }
    cur += ch;
  }
  parts.push(cur);

  const seen = new Set(), clauses = [];
  parts.forEach(part => {
    const alts = []; let subject = null, m;
    const re = /(\/)?\s*(?:\b([A-Z]{3,4}) )?(\d{3}[A-Z]?)(?![\d-])/g;   // [slash] [SUBJ] NNN[A]
    while((m = re.exec(part))){
      const [, slash, subj, num] = m;
      if(subj) subject = subj;
      else if(!(slash || /\bor\s*$/.test(part.slice(0, m.index))) || !subject) continue;   // a bare number only counts right after a "/" or an "or"
      const code = subject + num;
      if(COURSES[code] && code !== self) alts.push(canon(code));
    }
    const uniq = [...new Set(alts)];
    const key = uniq.slice().sort().join('|');
    if(uniq.length && !seen.has(key)){ seen.add(key); clauses.push(uniq); }
  });
  return clauses;
}
