    -webkit-print-color-adjust:exact;print-color-adjust:exact}
  .mark{display:inline-block;font:12px 'IBM Plex Mono',monospace;color:#555;border:1px solid rgba(17,17,17,.22);padding:2px 7px;border-radius:2px}
  h1{font:600 26px/1.05 'Spectral',serif;margin:8px 0 4px}
  h1 em{font-weight:400;color:#555}
  .note{font-size:11.5px;line-height:1.4;color:#555;max-width:90ch;margin:0 0 14px}
  .grid{display:grid;grid-template-columns:repeat(${n},minmax(210px,1fr));grid-template-rows:auto 1fr 1fr${extra.map(() => ' auto').join('')};
    border-top:2px solid #111;border-left:2px solid #111}
  .hd{background:#111;color:#fff;font:600 18px 'Spectral',serif;padding:8px 12px;border-right:2px solid #111}
