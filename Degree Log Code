}
#trResize::after{content:"";position:absolute;top:50%;left:3px;width:2px;height:40px;margin-top:-20px;border-radius:1px;background:var(--line);transition:background .15s ease}
#trResize:hover::after,#trResize:focus-visible::after,html.tr-resizing #trResize::after{background:var(--ink-soft)}
