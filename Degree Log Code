// One-click first year: the usual Year 1 courses, placed only where the normal rules allow.
const STARTER_YEAR = {fall:["ERTH210","MATH249","CHEM204","PHYS211"], winter:["CHEM206","MATH211","CPSC217"]};
function placeFirstYear(){
  let n = 0;
  if(skippedYears.has(1)) return 0;
  ['fall','winter'].forEach(t => STARTER_YEAR[t].forEach(code => {
    if(isAnywhereOnSheet(code) || !courseIsAddable(code, 1, t)) return;
    if(levelOf(code) === 200 && juniorUnitsNow() + unitsOf(code) > JUNIOR_MAX) return;   // 54 U cap on 200-level courses
    ensureSlot(1, t).push({code, source:'elective', track:'MAND'});
    n++;
  }));
  return n;
}
function layFirstYear(){
  const n = placeFirstYear();
  tidyPlan();
  renderColumn();
  if(n) showToast(`Laid a standard first year: <b>${n} courses</b>. Rearrange with ⇄ or remove with ×.`);
}

// One-click field school year: standard first year, then ERTH 290 in the Spring after it.
function layFieldSchoolYear(){
  const backup = JSON.stringify({plan, added:[...addedTerms]});
  const violationsBefore = sheetViolations();
  const first = skippedYears.has(1) ? 0 : placeFirstYear();
  const fs = [['spring','ERTH290']];
  const placed = [];
  fs.forEach(([t, code]) => {
    if(isAnywhereOnSheet(code)) return;
    addedTerms.add(slotKey('1s', t));
    if(!courseIsAddable(code, '1s', t) || (levelOf(code) === 200 && juniorUnitsNow() + unitsOf(code) > JUNIOR_MAX)){ if(!(plan[slotKey('1s', t)] || []).length) addedTerms.delete(slotKey('1s', t)); return; }
    ensureSlot('1s', t).push({code, source:'elective', track:'MAND'});
    placed.push(code);
  });
  if(sheetViolations() > violationsBefore){
    const b = JSON.parse(backup);
    plan = b.plan; addedTerms = new Set(b.added);
    placed.length = 0;
  }
  tidyPlan();
  renderColumn();
  const n = placed.length + (placed.length ? first : 0);
  if(n) showToast(`Laid a standard first year with field school: <b>${n} courses</b> (ERTH 290 in Spring). Rearrange with ⇄ or remove with ×.`);
}

// One-click second year: the six core 300-level ERTH courses, plus any missing prerequisites placed earlier.
const STARTER_YEAR2 = {fall:["ERTH310","ERTH320","ERTH340"], winter:["ERTH330","ERTH350","ERTH360"]};
function layStandardYear2(){
  if(skippedYears.has(2)) return;
  const juniorBefore = juniorUnitsNow();
  const backup = JSON.stringify({plan, added:[...addedTerms]});
  const violationsBefore = sheetViolations();
  const codesBefore = sheetCodes();
  const first = skippedYears.has(1) ? 0 : placeFirstYear();
  const placed = [];
  ['fall','winter'].forEach(t => STARTER_YEAR2[t].forEach(code => {
    if(isAnywhereOnSheet(code) || !courseIsAddable(code, 2, t)) return;
    ensureSlot(2, t).push({code, source:'elective', track:'MAND'});
    placed.push([code, t]);
  }));
  placed.forEach(([code, t]) => addPrereqsFor(code, 'MAND', new Set(), posIndex(2, t)));
  // Field school: ERTH 390 in the Spring after Year 2 (ERTH 290 is added earlier as its prerequisite if missing).
  if(!isAnywhereOnSheet('ERTH390')){
    addedTerms.add(slotKey('2s', 'spring'));
    if(courseIsAddable('ERTH390', '2s', 'spring')){
      ensureSlot('2s', 'spring').push({code:'ERTH390', source:'elective', track:'MAND'});
      placed.push(['ERTH390', 'spring']);
      addPrereqsFor('ERTH390', 'MAND', new Set(), posIndex('2s', 'spring'));
    } else if(!(plan[slotKey('2s', 'spring')] || []).length) addedTerms.delete(slotKey('2s', 'spring'));
  }
  if(sheetViolations() > violationsBefore || (juniorUnitsNow() > JUNIOR_MAX && juniorUnitsNow() > juniorBefore)){
    if(juniorUnitsNow() > JUNIOR_MAX) showToast(juniorMsg('the standard second year') + ' Its prerequisites would count too.');
    const b = JSON.parse(backup);
    plan = b.plan; addedTerms = new Set(b.added);
    placed.length = 0;
  }
  const firstKept = placed.length ? first : 0;
  tidyPlan();
  renderColumn();
  const extra = [...sheetCodes()].filter(c => !codesBefore.has(c)).length - placed.length - firstKept;
  if(placed.length) showToast(`Laid a standard ${firstKept ? 'first and second year' : 'second year'} with field school (ERTH 390 in the Spring after Year 2): <b>${placed.length + firstKept} courses</b>${extra > 0 ? ` plus ${extra} missing prerequisite${extra === 1 ? '' : 's'}` : ''}. Rearrange with ⇄ or remove with ×.`);
}

/* ---------- add a semester ---------- */
let semTerm = null;
const SEM_TERMS = ['spring','summer'];
function openSem(){ semTerm = null; renderSem(); document.getElementById('semOverlay').classList.add('open'); }
function closeSem(){ document.getElementById('semOverlay').classList.remove('open'); }
function pickSemTerm(t){ semTerm = t; renderSem(); }
function renderSem(){
