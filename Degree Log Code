    TRACK_CODES[track].add(code);
    if(!REVERSE_MAP[code]) REVERSE_MAP[code] = track;
    if(kind === 'elective'){ electives.add(code); (ELECTIVE_HOMES[code] ||= []).includes(track) || ELECTIVE_HOMES[code].push(track); }
  });
  TRACK_ALL_ELECTIVES[track] = [...electives];
});

/* =====================================================================
   PREREQUISITE LOGIC
   ===================================================================== */
// A requirement is a list of alternatives, any one of which meets it.
const prereqClausesOf = code => PREREQS[code] || [];
const clauseMentions  = (clause, code) => clause.some(c => sameCourse(c, code));
const clauseLabel     = clause => clause.map(codeLabel).join(' or ');

let plan = {};                  // "year|term" -> [{code, source, track}]
let skippedYears = new Set();   // years marked "completed elsewhere"
let deletedYears = new Set();   // skipped years the user deleted outright: hidden, and NOT counted as completed
let addedTerms = new Set();     // Spring/Summer terms the user has added, e.g. "1s|spring"
const slotKey = (y,t) => `${y}|${t}`;
function ensureSlot(y,t){ const k = slotKey(y,t); return plan[k] || (plan[k] = []); }
function planKeyToPos(k){ const [y,t] = k.split('|'); return posIndex(normYear(y), t); }

// Courses that can be taken more than once (one copy per term). Every other course can only be on the sheet once.
const REPEATABLE = new Set(["ERTH570","ERTH580A","ERTH580B","ERTH590","ERTH599"]);
// Where a course sits on the sheet: its earliest copy, if it has been taken more than once.
function findOnSheet(code){
  let best = null, bestPos = Infinity;
  for(const k in plan) if(plan[k].some(e => sameCourse(e.code, code))){
    const p = planKeyToPos(k);
    if(best === null || p < bestPos){ best = k; bestPos = p; }
  }
  return best;
}
const isAnywhereOnSheet = code => findOnSheet(code) !== null;

// Terms a course is offered in. Unparseable → Fall/Winter so we never falsely block.
function courseOfferedTerms(code){
  const t = (COURSES[code]?.term || '').toLowerCase();
  const terms = ['fall','winter','spring','summer'].filter(x => t.indexOf(x) !== -1);
  return terms.length ? terms : ['fall','winter'];
}
const courseTermOk = (code, term) => courseOfferedTerms(code).indexOf(term) !== -1;

// Earliest ORDER_LIST position a course could be completed by, derived from its
// prerequisites and the terms it's offered. A course already on the sheet is ground truth.
function earliestPosition(code, visiting = new Set(), core2 = false){
  const k = findOnSheet(code);
  if(k) return planKeyToPos(k);
  if(!COURSES[code] || visiting.has(code)) return null;
  visiting.add(code);
  // core2: the 300-level core ERTH courses are normally taken from Year 2 Fall on
  let afterPos = (core2 && isYear2Core(code)) ? posIndex(2,'fall') - 1 : -1;
  if(code === 'GEOG380') afterPos = Math.max(afterPos, posIndex(1,'fall'));   // as a prerequisite it goes in the second semester or later
  prereqClausesOf(code).forEach(clause => {
    // the requirement is met as soon as the quickest alternative could be done
    const ps = clause.map(pc => earliestPosition(pc, visiting, core2)).filter(p => p !== null);
    if(ps.length){ const m = Math.min(...ps); if(m > afterPos) afterPos = m; }
  });
  visiting.delete(code);
  const terms = courseOfferedTerms(code);
  for(let i = afterPos+1; i < ORDER_LIST.length; i++){
    if(terms.indexOf(ORDER_LIST[i].t) !== -1) return i;
  }
  return null; // doesn't fit anywhere on the modelled timeline
}

// A skipped year counts everything normally taken in it as done.
function completedElsewhere(code){
  if(isAnywhereOnSheet(code)) return false;
  const ep = earliestPosition(code);
  return ep !== null && skippedYears.has(ORDER_LIST[ep].y) && !deletedYears.has(ORDER_LIST[ep].y);
}

// Prerequisites that can't genuinely be finished strictly before this slot.
function unmetPrereqs(code, year, term){
  const target = posIndex(year, term);
  if(target === -1) return [];
  const core2 = levelOf(code) >= 400 && parseInt(year,10) >= 3; // same rule addPrereqsFor uses to place them
  // returns the requirements (lists of alternatives) where even the quickest option lands too late
  return prereqClausesOf(code).filter(clause => {
    const ps = clause.map(pc => earliestPosition(pc, new Set(), core2)).filter(p => p !== null);
    return ps.length > 0 && Math.min(...ps) >= target; // nothing placeable (null) → can't verify, don't block
  });
}
// Courses already on the sheet that need `code` and sit in this term or earlier.
// (Placing `code` there would put a course before its own prerequisite.)
function blockedByDependents(code, year, term){
  const target = posIndex(year, term);
  if(target === -1) return [];
  const out = new Set();
  const copyPos = [];   // other copies of a repeatable course already on the sheet
  for(const k in plan) if(plan[k].some(e => e.code === code)) copyPos.push(planKeyToPos(k));
  for(const k in plan) plan[k].forEach(e => {
    const at = planKeyToPos(k);
    if(e.code === code || at > target) return;
    prereqClausesOf(e.code).forEach(clause => {
      if(!clauseMentions(clause, code)) return;
      // fine if another copy of this course, or a different alternative, already meets this requirement before `e`
      if(copyPos.some(p => p < at)) return;
      const covered = clause.some(c => {
        if(sameCourse(c, code)) return false;
        const p = actualPositionOnSheet(c);
        return p !== null && p < at;
      });
      if(!covered) out.add(e.code);
    });
  });
  return [...out];
}
const courseIsAddable = (code, year, term) =>
  unmetPrereqs(code, year, term).length === 0 && courseTermOk(code, term) && blockedByDependents(code, year, term).length === 0;

// Where is `code` concretely on the sheet (or covered by a skipped year)? No "could be" fallback.
function actualPositionOnSheet(code){
  const k = findOnSheet(code);
  if(k) return planKeyToPos(k);
  const ep = earliestPosition(code);
  return (ep !== null && skippedYears.has(ORDER_LIST[ep].y) && !deletedYears.has(ORDER_LIST[ep].y)) ? ep : null;
}
function unsatisfiedOnSheet(code, year, term){
  const target = posIndex(year, term);
  if(target === -1) return [];
  return prereqClausesOf(code).filter(clause => !clause.some(pc => {
    const pos = actualPositionOnSheet(pc);
    return pos !== null && pos < target;
  }));
}

// Term for an auto-added prerequisite: earliest offered term at/after its earliest
// position, strictly before `beforePos`. Spring/Summer terms are only used if the user
// already added them, or the course is only offered then.
function placeSlotFor(code, beforePos, core2 = false){
  const ep = earliestPosition(code, new Set(), core2);
  const start = ep === null ? 0 : ep;
  const end = beforePos == null ? ORDER_LIST.length : Math.min(beforePos, ORDER_LIST.length);
  const terms = courseOfferedTerms(code);
  const bridgeOnly = terms.every(t => t === 'spring' || t === 'summer');
  const offered = o => terms.indexOf(o.t) !== -1 && !skippedYears.has(o.y);
  const scan = (from, to, pred) => { for(let i = from; i < to; i++) if(pred(ORDER_LIST[i])) return ORDER_LIST[i]; return null; };
  // A GEOG course added as a prerequisite goes in the year before the course that needs it, so a Year 4 GEOG 500-level
  // pulls a 400-level into Year 3 and GEOG 380 into Year 2 (not everything crammed into the earliest possible term).
  // GEOG 380 itself goes no earlier than Year 2 Fall unless the course needing it is in Year 2 (then Year 1 Winter).
  // Anything earlier is only a fallback.
  let pref = start;
  if(subjectOf(code) === 'GEOG' && beforePos != null && ORDER_LIST[beforePos]){
    const depY = parseInt(ORDER_LIST[beforePos].y, 10);
    const wantPos = code === 'GEOG380'
      ? (depY >= 3 ? posIndex(depY - 1, 'fall') : posIndex(1, 'winter'))
      : posIndex(Math.max(1, depY - 1), 'fall');
    if(wantPos !== -1) pref = Math.max(start, wantPos);
  }
  const normal = o => offered(o) && (!isBridgeYear(o.y) || bridgeOnly || addedTerms.has(slotKey(o.y,o.t)));
  return scan(pref, end, normal)
      || scan(pref, end, offered)
      || (pref !== start ? scan(start, end, offered) : null);  // never later than the course that needs it
}

function chipTrackFor(code, track){
  if(MANDATORY_ALL.has(code)) return 'MAND';
  if(FIELD_CODES.indexOf(code) !== -1) return 'FIELD';
  // A prerequisite takes the colour of the field that lists it as an elective (ERTH 315 → Geochemistry),
  // not whichever field's core slot happens to share it (Soft/Hard Rock). If the current field also lists it, keep that.
  const homes = ELECTIVE_HOMES[code];
  if(homes) return homes.includes(track) ? track : homes[0];
  if(track && TRACK_CODES[track]?.has(code)) return track;
  return REVERSE_MAP[code] || (TRACK_CODES[track] ? track : 'MAND');
}

// Auto-add only what `code` genuinely needs: its prerequisites and, recursively, theirs.
// The six core ERTH courses (300-level mandatory) are normally taken in Year 2.
const isYear2Core = c => MANDATORY_ERTH.indexOf(c) !== -1 && levelOf(c) === 300;

function addPrereqsFor(code, track, visited = new Set(), beforePos, core2 = false){
  if(visited.has(code)) return;
  visited.add(code);
  prereqClausesOf(code).forEach(clause => {
    // 1. An alternative already on the sheet before this course meets the requirement: keep it, check ITS prerequisites.
    const placed = clause
      .filter(c => isAnywhereOnSheet(c) && (beforePos == null || actualPositionOnSheet(c) < beforePos))
      .sort((x, y) => actualPositionOnSheet(x) - actualPositionOnSheet(y));
    if(placed.length){
      addPrereqsFor(placed[0], track, visited, actualPositionOnSheet(placed[0]), core2);
      return;
    }
    // 2. A skipped year already covers one of the alternatives.
    if(clause.some(c => completedElsewhere(c))) return;
    // 3. Otherwise add one alternative: courses the degree requires anyway come first, then the listed order.
    const ordered = clause.slice().sort((x, y) => MANDATORY_ALL.has(y) - MANDATORY_ALL.has(x));
    for(const c of ordered){
      const slot = placeSlotFor(c, beforePos, core2);
      if(!slot) continue;
      if(isBridgeYear(slot.y)) addedTerms.add(slotKey(slot.y, slot.t));
      ensureSlot(slot.y, slot.t).push({code:c, source:'auto-prereq', track:chipTrackFor(c, track)});
      addPrereqsFor(c, track, visited, posIndex(slot.y, slot.t), core2);
      return;
    }
  });
}

let toastTimer = null;
function showToast(html){
  document.getElementById('toast-text').innerHTML = html;
  document.getElementById('toast').classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(hideToast, 10000);
}
function hideToast(){ clearTimeout(toastTimer); document.getElementById('toast').classList.remove('show'); }
const sheetCodes = () => new Set(Object.values(plan).flat().map(e => e.code));

function sheetViolations(){
  let n = 0;
  for(const k in plan){ const [y,t] = k.split('|'); plan[k].forEach(e => { n += unsatisfiedOnSheet(e.code, normYear(y), t).length; }); }
  return n;
}
function addElective(year, term, track, code){
  year = normYear(year);
  const arr = ensureSlot(year, term);
  if(arr.some(e => e.code === code)){ closePicker(); return; }
  if(!courseIsAddable(code, year, term)) return; // the picker already disables these
  if(levelOf(code) === 200 && juniorUnitsNow() + unitsOf(code) > JUNIOR_MAX){ closePicker(); showToast(juniorMsg(codeLabel(code))); return; }
  const juniorBefore = juniorUnitsNow();
  const backup = JSON.stringify({plan, added:[...addedTerms]});
  const violationsBefore = sheetViolations();
  const codesBefore = sheetCodes();
  arr.push({code, source:'elective', track: MANDATORY_ALL.has(code) ? 'MAND' : track});
  addPrereqsFor(code, track, new Set(), posIndex(year, term), levelOf(code) >= 400 && parseInt(year,10) >= 3);
  // ERTH 580 is a two-term course: picking 580A also places 580B in the Winter that follows.
  let companion = null;
  if(code === 'ERTH580A'){
    const next = ORDER_LIST[posIndex(year, term) + 1];
    if(next && next.t === 'winter' && !(plan[slotKey(next.y, next.t)] || []).some(e => e.code === 'ERTH580B')){
      ensureSlot(next.y, next.t).push({code:'ERTH580B', source:'elective', track});
      companion = 'ERTH580B';
    }
  }
  const overJunior = juniorUnitsNow() > JUNIOR_MAX && juniorUnitsNow() > juniorBefore;   // its prerequisites would push past 54 U
  if(sheetViolations() > violationsBefore || overJunior){   // couldn't fit it and its prerequisites in order
    const b = JSON.parse(backup);
    plan = b.plan; addedTerms = new Set(b.added);
    if(overJunior) showToast(juniorMsg(codeLabel(code)) + ' Its prerequisites would count too.');
  }
  const addedPrereqs = [...sheetCodes()].filter(c => c !== code && c !== companion && !codesBefore.has(c));
  closePicker();
  renderColumn();
  if(companion && isAnywhereOnSheet(companion) && !addedPrereqs.length){
    showToast(`Added <b>${codeLabel(code)}</b> and <b>${codeLabel(companion)}</b> in the following Winter.`);
  } else if(addedPrereqs.length){
    showToast(`Added <b>${codeLabel(code)}</b> and ${addedPrereqs.length === 1 ? 'its prerequisite' : addedPrereqs.length + ' prerequisites'}: ${addedPrereqs.map(codeLabel).join(', ')}.`);
  }
}

/* ---------- removal ---------- */
// Drop anything whose prerequisites are no longer on the sheet, until stable.
function cascadeRemoveOrphans(){
  let changed = true;
  for(let guard = 0; changed && guard < 50; guard++){
    changed = false;
    for(const k in plan){
      const [y,t] = k.split('|');
      const year = normYear(y);
      const kept = plan[k].filter(e => unsatisfiedOnSheet(e.code, year, t).length === 0);
      if(kept.length !== plan[k].length){ plan[k] = kept; changed = true; }
    }
  }
}
function isNeededByAnyCourseOnSheet(code){
  return Object.values(plan).some(list => list.some(e => e.code !== code && prereqClausesOf(e.code).some(cl => clauseMentions(cl, code))));
}
// An auto-added prerequisite that nothing needs any more becomes a normal, removable course.
function promoteOrphanedAutoAdds(){
  Object.values(plan).forEach(list => list.forEach(e => {
    if(e.source === 'auto-prereq' && !isNeededByAnyCourseOnSheet(e.code)) e.source = 'elective';
  }));
}
const tidyPlan = () => { cascadeRemoveOrphans(); promoteOrphanedAutoAdds(); };

function doRemoveEntry(year, term, code){
  const k = slotKey(normYear(year), term);
  if(!plan[k]) return;
  plan[k] = plan[k].filter(e => e.code !== code);
  if(code === 'ERTH580A'){   // its 580B in the following Winter goes with it
    const next = ORDER_LIST[posIndex(normYear(year), term) + 1];
    const nk = next && next.t === 'winter' ? slotKey(next.y, next.t) : null;
    if(nk && plan[nk]) plan[nk] = plan[nk].filter(e => e.code !== 'ERTH580B');
  }
  tidyPlan();
  renderColumn();
}

// What else would disappear if this course were removed? (tries it on a copy, then puts everything back)
function removalFallout(year, term, code){
  const k = slotKey(normYear(year), term);
  if(!plan[k]) return {direct:[], indirect:[]};
  const saved = JSON.stringify(plan);
  const codesBefore = new Set(Object.values(plan).flat().map(e => e.code));
  plan[k] = plan[k].filter(e => e.code !== code);
  cascadeRemoveOrphans();
  const gone = [...codesBefore].filter(c => c !== code && !isAnywhereOnSheet(c));
  plan = JSON.parse(saved);
  const direct = gone.filter(c => prereqClausesOf(c).some(cl => clauseMentions(cl, code)));
  return {direct, indirect: gone.filter(c => direct.indexOf(c) === -1)};
}

let pendingRemove = null;
const codeList = list => list.map(codeLabel).join(', ');
function removeEntry(year, term, code){
  const fallout = removalFallout(year, term, code);
  if(code === 'ERTH580A'){   // 580B always goes with 580A, so no warning is needed for it
    fallout.direct = fallout.direct.filter(c => c !== 'ERTH580B');
    fallout.indirect = fallout.indirect.filter(c => c !== 'ERTH580B');
  }
  if(!fallout.direct.length && !fallout.indirect.length){ doRemoveEntry(year, term, code); return; }
  pendingRemove = {year, term, code};
  document.getElementById('warn-confirm').textContent = 'Remove anyway';
  document.getElementById('warn-title').textContent = `${codeLabel(code)} is a prerequisite`;
  let html = `<p class="warn-text">It is needed for <b>${codeList(fallout.direct)}</b>. Removing it will remove ${codeList(fallout.direct)} too.</p>`;
  if(fallout.indirect.length) html += `<p class="warn-text">That also takes out ${codeList(fallout.indirect)}, which ${fallout.indirect.length > 1 ? 'depend' : 'depends'} on ${fallout.direct.length > 1 ? 'them' : 'it'}.</p>`;
  document.getElementById('warn-body').innerHTML = html;
  document.getElementById('warnOverlay').classList.add('open');
  document.getElementById('warn-keep').focus();
}
function closeWarn(){ pendingRemove = null; document.getElementById('warnOverlay').classList.remove('open'); }
function confirmRemove(){
  const r = pendingRemove;
  closeWarn();
  if(!r) return;
  if(r.reset){ chooserOpen.clear(); hideToast(); closeDrawer(); restoreSnapshot({v:1}); }
  else doRemoveEntry(r.year, r.term, r.code);
}

/* =====================================================================
   OPEN-OPTION SLOTS ("type your own course" inputs)
   ===================================================================== */
let optionSlots = {};
let slotIdCounter = 0;
const ensureOptionSlot = (year, term) => optionSlots[slotKey(year,term)] || (optionSlots[slotKey(year,term)] = []);
function addSlot(year, term, category){
  const cat = SLOT_CATS[category] ? category : 'open';
  ensureOptionSlot(year, term).push({id:'opt'+(++slotIdCounter), label:cat === 'open' ? 'Additional option' : SLOT_CATS[cat], value:'', credits:'', category:cat, editing:true});
  renderColumn();
}
function removeSlot(year, term, id){
  optionSlots[slotKey(year,term)] = ensureOptionSlot(year, term).filter(s => s.id !== id);
  renderColumn();
}
function updateSlotValue(year, term, id, value){ updateSlotField(year, term, id, 'value', value); }
function updateSlotField(year, term, id, field, value){
  const slot = ensureOptionSlot(year, term).find(s => s.id === id);
  if(slot){ slot[field] = value; persist(true); renderTracker(); } // no column re-render per keystroke
}
const SLOT_CATS = {open:'Open option', science:'Science option', nonsci:'Non-science option', arts:'Non-science (Arts)', gge:'GGE option'};
const slotCat = slot => SLOT_CATS[slot.category] ? slot.category : 'open';
const slotUnits = slot => Math.max(0, parseFloat(slot.credits) || 0);
const slotEditing = slot => slot.editing === undefined ? !slot.value.trim() : slot.editing;
function confirmSlot(year, term, id){
  const slot = ensureOptionSlot(year, term).find(s => s.id === id);
  if(!slot) return;
  if(isJuniorText(slot.value) && juniorUnitsNow(slot.id) + (slotUnits(slot) || 3) > JUNIOR_MAX){
    showToast(juniorMsg(escHtml(slot.value.trim())) + ' Change the course or remove it.');
    return;   // stays open for editing
  }
  if(!slot.value.trim()) slot.value = SLOT_CATS[slotCat(slot)];
  slot.editing = false;
  renderColumn();
}
function editSlot(year, term, id){
  const slot = ensureOptionSlot(year, term).find(s => s.id === id);
  if(!slot) return;
  slot.editing = true;
  renderColumn();
  document.getElementById('slot-in-' + id)?.focus();
}
const slotEnter = (year, term, id) => `onkeydown="if(event.key==='Enter'){event.preventDefault();confirmSlot('${year}','${term}','${id}')}"`;
const slotRow = (year, term, slot) => {
  const remove = `<button class="chip-x no-print" onclick="removeSlot('${year}','${term}','${slot.id}')" title="remove this option">×</button>`;
  if(!slotEditing(slot)){
    const u = slotUnits(slot);
    return `<span class="slot-wrap"><button class="chip slot-chip" onclick="editSlot('${year}','${term}','${slot.id}')" title="${escapeAttr(SLOT_CATS[slotCat(slot)] + (u ? ', ' + u + ' U' : ', no units entered') + ' — click to edit')}">${escHtml(slot.value)}</button>${remove}</span>`;
  }
  return `<span class="slot-wrap">`
    + `<input class="slot-input" id="slot-in-${slot.id}" placeholder="${escapeAttr(slot.label)} — type your course" value="${escapeAttr(slot.value)}" ${slotEnter(year, term, slot.id)} oninput="updateSlotValue('${year}','${term}','${slot.id}', this.value)">`
    + `<select class="slot-select" aria-label="Type of option" onchange="updateSlotField('${year}','${term}','${slot.id}','category', this.value)">`
    + Object.keys(SLOT_CATS).filter(k => k !== 'open' || slotCat(slot) === 'open').map(k => `<option value="${k}"${slotCat(slot) === k ? ' selected' : ''}>${SLOT_CATS[k]}</option>`).join('')
    + `</select>`
    + `<input class="slot-credits" type="number" min="0" max="12" step="0.5" placeholder="units" aria-label="Units for this course" value="${escapeAttr(slot.credits)}" ${slotEnter(year, term, slot.id)} oninput="updateSlotField('${year}','${term}','${slot.id}','credits', this.value)">`
    + `<button class="chip slot-done no-print" onclick="confirmSlot('${year}','${term}','${slot.id}')" title="done">✓</button>`
    + remove
    + `</span>`;
};

/* =====================================================================
   RENDERING
   ===================================================================== */
function renderCourseRow(year, term){
  const entries = plan[slotKey(year,term)] || [];
  let html = `<div class="chips elective-chips" ondragover="event.preventDefault()" ondragenter="this.classList.add('drop-hover')" ondragleave="this.classList.remove('drop-hover')" ondrop="this.classList.remove('drop-hover'); handleDrop(event,'${year}','${term}')">`;
  entries.forEach(e => {
    const auto = e.source === 'auto-prereq';
    const cls = `chip-track-${shownTrack(e.code, e.track)}${reqErthCls(e.code, e.track)}${auto ? ' auto-prereq' : ''}`;
    html += `<span class="elective-wrap" draggable="true" ondragstart="startDrag(event,'${year}','${term}','${e.code}')">`
          + `<button class="chip ${cls}" title="${escapeAttr(courseTip(e.code))}" onclick="openDrawer('${e.code}')">${auto ? '<span class="tag">prereq</span>' : ''}${codeLabel(e.code)}${TRACK_META[e.track] && !MANDATORY_ALL.has(e.code) ? `<span class="trk">${e.track}</span>` : ''}</button>`
          + `<button class="chip-x no-print" onclick="openMove('${year}','${term}','${e.code}')" title="move to another term">⇄</button>`
          + `<button class="chip-x no-print" onclick="removeEntry('${year}','${term}','${e.code}')" title="remove">×</button>`
          + `</span>`;
  });
  return html + `<button class="chip add-elective no-print" onclick="openPicker('${year}','${term}')" title="add a course or an open option">+ add</button></div>`;
}

function termBlock(name, year, term){
  let html = `<div class="term-block"><div class="term-name">${name}</div>`;
  if(isBridgeYear(year)){
    html += ` <button class="chip-x no-print" onclick="removeBridgeTerm('${year}','${term}')" title="remove this ${name} term">×</button>`;
  }
  const slots = ensureOptionSlot(year, term);
  if(slots.length) html += `<div class="chips">${slots.map(s => slotRow(year, term, s)).join('')}</div>`;
  html += renderCourseRow(year, term) + `</div>`;
  return html;
}

function renderColumn(){
  let lastUsed = Math.max(0, ...YEAR_ORDER.filter(y => typeof y === 'number' && yearHasContent(y)));
  addedTerms.forEach(k => { lastUsed = Math.max(lastUsed, parseInt(k, 10)); });
  YEAR_ORDER.forEach(y => { if(typeof y === 'number' && y <= lastUsed) expandedYears.add(y); });
  const parts = YEAR_ORDER.map(y => {
    const req = REQUIRED[y];
    const id = 'yr-' + y;

    if(YEAR_TITLE[y] && deletedYears.has(y)) return '';   // deleted years leave the page entirely

    if(YEAR_TITLE[y] && skippedYears.has(y)){
      return `<div class="stratum skipped" id="${id}"><div class="tick"></div><div class="yr-tag">${YEAR_TITLE[y]}</div>
        <p class="stratum-label skip-note">marked as already completed — anything that would normally be taken this year counts as done for prerequisites
          <button class="restore-btn no-print" onclick="toggleSkipYear(${y})">↺ restore this year</button>
          <button class="restore-btn no-print" onclick="deleteYear(${y})" title="remove this year from the plan entirely (it will no longer count as completed)">✕ delete this year</button></p></div>`;
    }

    // Later years stay hidden until they are added or contain something.
    if(isCollapsed(y)) return '';

    // A break with no Spring/Summer term yet stays hidden; "+ add a semester" creates it.
    if(req.bridge && !bridgeHasTerms(y)) return '';

    let html = `<div class="stratum" id="${id}"><div class="tick"></div>`;
    if(YEAR_TITLE[y]){
      html += `<div class="yr-tag">${YEAR_TITLE[y]}</div>`;
      // Added years (5+) get the same completed / delete controls as years 1-4.
      html += `<button class="year-toggle no-print" onclick="toggleSkipYear(${y})" title="mark this year as already completed elsewhere">−</button>`;
    } else {
      html += `<div class="yr-tag" style="font-size:11px;line-height:1.15;white-space:nowrap">Spring/<br>Summer</div>`;
    }
    html += `<p class="stratum-label">${req.label}</p>`;
    if(y === 1 && !yearHasContent(1)){
      html += `<div class="start-prompt no-print"><div class="chips"><button class="chip add-elective" type="button" onclick="layFirstYear()">standard first year</button></div></div>`;
    }

    if(y === 1 && !bridgeHasTerms('1s')){
      html += `<div class="chips no-print" style="margin-top:10px"><button class="chip add-elective" type="button" onclick="layFieldSchoolYear()">standard first year + field school</button></div>`;
    }

    if(y === 2){
      const missing2 = [...STARTER_YEAR2.fall, ...STARTER_YEAR2.winter, 'ERTH390'].filter(c => !isAnywhereOnSheet(c));
      if(!yearHasContent(2)){
        html += `<div class="start-prompt no-print"><p class="stratum-label">Lay your second layer — the six core ERTH courses and ERTH 390 field school, with a standard first year beneath it.</p>
          <div class="chips"><button class="chip add-elective" type="button" onclick="layStandardYear2()">standard second year + field school</button></div></div>`;
      } else if(missing2.length){
        html += `<div class="start-prompt no-print"><div class="chips"><button class="chip add-elective" type="button" onclick="layStandardYear2()" title="adds only what's missing: ${escapeAttr(missing2.map(codeLabel).join(', '))}">standard second year + field school</button></div></div>`;
      }
    }

    if(req.bridge){
      const shown   = ['spring','summer'].filter(t =>  addedTerms.has(slotKey(y,t)));
      const missing = ['spring','summer'].filter(t => !addedTerms.has(slotKey(y,t)));
      if(shown.length) html += `<div class="terms-row" style="margin-top:14px">${shown.map(t => termBlock(termLabel(t), y, t)).join('')}</div>`;
      if(missing.length) html += `<div class="chips no-print" style="margin-top:10px">${missing.map(t => `<button class="chip add-elective" onclick="addBridgeTerm('${y}','${t}')">+ add ${termLabel(t)} term</button>`).join('')}</div>`;
    } else {
      html += `<div class="terms-row">${termBlock('Fall', y, 'fall')}${termBlock('Winter', y, 'winter')}</div>`;
    }
    return html + `</div>`;
  });

  parts.push(`<div class="stratum add-year-row no-print"><div class="tick add-tick"></div>
    <button class="chip add-year-btn" onclick="addAcademicYear()">+ add an academic year</button>
    <button class="chip add-year-btn" onclick="openSem()">+ add a spring/summer semester</button></div>`);

  document.getElementById('column').innerHTML = parts.join('');
  renderSideNav();
  setupNavObserver();
  renderTracker();
  persist();
}

/* ---------- drag and drop between course rows ---------- */
let dragSource = null;
function startDrag(ev, year, term, code){
  dragSource = {year:normYear(year), term, code};
  if(ev.dataTransfer){
    ev.dataTransfer.effectAllowed = 'move';
    try{ ev.dataTransfer.setData('text/plain', code); }catch(err){}
  }
}
function handleDrop(ev, year, term){
  ev.preventDefault();
  year = normYear(year);
  const from = dragSource;
  dragSource = null;
  if(!from || (from.year === year && from.term === term)) return;

  const fromKey = slotKey(from.year, from.term);
  const idx = (plan[fromKey] || []).findIndex(e => e.code === from.code);
  if(idx === -1 || (plan[slotKey(year,term)] || []).some(e => e.code === from.code)) return;

  // Lift it out first so its own prereq check isn't confused by its old position,
  // then check it fits (prereq timing + offered that term). If not, snap back.
  const [entry] = plan[fromKey].splice(idx, 1);
  if(!courseIsAddable(from.code, year, term)){
    plan[fromKey].splice(idx, 0, entry);
  } else {
    ensureSlot(year, term).push(entry);
    tidyPlan();
  }
  renderColumn();
}

/* ---------- Spring / Summer terms are added by hand ---------- */
// Years 2+ stay folded away until opened (or until a course lands in them).
let expandedYears = new Set();
const yearHasContent = y => ['fall','winter'].some(t => (plan[slotKey(y,t)] || []).length || (optionSlots[slotKey(y,t)] || []).length);
const isCollapsed    = y => typeof y === 'number' && y >= 2 && !expandedYears.has(y);
function expandYear(y){ expandedYears.add(normYear(y)); renderColumn(); }
function toggleDisclaimer(btn){
  const more = document.getElementById('disc-more');
