function renderTracker(){
  const box = document.getElementById('trBody');
  if(!box) return;
  const tab = (id, label) => `<button class="tr-tab${trackerTab === id ? ' active' : ''}" type="button" onclick="setTrackerTab('${id}')">${label}</button>`;
  const sub = (id, label) => `<button class="tr-subtab${trackerSub === id ? ' active' : ''}" type="button" onclick="setTrackerSub('${id}')">${label}</button>`;
  let html = `<div class="tr-tabs">${tab('geo','B.Sc.')}${tab('hon','Honours')}${tab('res','Resources')}</div>`;
  if(trackerTab === 'res'){
    html += RESOURCES_HTML;
  }else{
    html += `<div class="tr-sub">${sub('info','Info')}${sub('tracker','Tracker')}</div>`;
    if(trackerSub === 'info') html += trackerTab === 'geo' ? infoGeo() : infoHon();
    else{
      const st = trackerStats();
      html += trackerTab === 'geo' ? trackerGeo(st) : trackerHon(st);
    }
  }
  box.innerHTML = html;
}
function setTrackerTab(t){ trackerTab = t; renderTracker(); }
function setTrackerSub(t){ trackerSub = t; renderTracker(); }

/* ---------- retractable side panel (open on first visit) ---------- */
function syncTrackerPanel(){
  const collapsed = document.documentElement.classList.contains('tr-collapsed');
  const btn = document.getElementById('trToggle');
  btn.textContent = collapsed ? '‹' : '›';
  btn.setAttribute('aria-expanded', String(!collapsed));
  const label = collapsed ? 'Show side panel' : 'Hide side panel';
  btn.setAttribute('aria-label', label); btn.setAttribute('title', label);
}
(function(){
  try{ if(localStorage.getItem('degreelog-panel') === 'closed') document.documentElement.classList.add('tr-collapsed'); }catch(e){}
  document.getElementById('trToggle').addEventListener('click', () => {
    const c = document.documentElement.classList.toggle('tr-collapsed');
    try{ localStorage.setItem('degreelog-panel', c ? 'closed' : 'open'); }catch(e){}
    syncTrackerPanel();
  });
  syncTrackerPanel();
})();

/* ---------- adjustable side panel width ---------- */
(function(){
  const root = document.documentElement, handle = document.getElementById('trResize');
  const MIN = 300;
  const maxW = () => Math.max(MIN, Math.min(720, window.innerWidth - 480));
  const defW = () => Math.max(340, Math.min(560, window.innerWidth - 1000));
  const clamp = w => Math.max(MIN, Math.min(maxW(), w));
  const current = () => parseInt(getComputedStyle(root).getPropertyValue('--tr-w'), 10) || 340;
  const set = (w, save) => {
    w = clamp(Math.round(w));
    root.style.setProperty('--tr-w', w + 'px');
    handle.setAttribute('aria-valuenow', w);
    if(save){ try{ localStorage.setItem('degreelog-panel-w', String(w)); }catch(e){} }
  };
  handle.setAttribute('aria-valuemin', MIN);
  set(current(), false);

  let startX = 0, startW = 0;
  handle.addEventListener('pointerdown', ev => {
    startX = ev.clientX; startW = current();
    handle.setPointerCapture(ev.pointerId);
    root.classList.add('tr-resizing');
    ev.preventDefault();
  });
  handle.addEventListener('pointermove', ev => {
    if(!root.classList.contains('tr-resizing')) return;
    set(startW + (startX - ev.clientX), false);   // dragging left makes the panel wider
  });
  const end = ev => {
    if(!root.classList.contains('tr-resizing')) return;
    root.classList.remove('tr-resizing');
    try{ handle.releasePointerCapture(ev.pointerId); }catch(e){}
    set(current(), true);
  };
  handle.addEventListener('pointerup', end);
  handle.addEventListener('pointercancel', end);
  handle.addEventListener('dblclick', () => {
    try{ localStorage.removeItem('degreelog-panel-w'); }catch(e){}
    set(defW(), false);
  });
  handle.addEventListener('keydown', ev => {
    if(ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
    ev.preventDefault();
    set(current() + (ev.key === 'ArrowLeft' ? 20 : -20), true);
  });
  window.addEventListener('resize', () => {
    let saved = null; try{ saved = localStorage.getItem('degreelog-panel-w'); }catch(e){}
    set(saved ? parseInt(saved, 10) : defW(), false);
  });
})();

/* ---------- theme ---------- */
function syncThemeButton(){
  const btn = document.getElementById('themeToggle');
  const dark = document.documentElement.getAttribute('data-theme') === 'dark';
  const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
  btn.textContent = dark ? '☀' : '☾';
  btn.setAttribute('aria-label', label);
  btn.setAttribute('title', label);
}
document.getElementById('themeToggle').addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  try{ localStorage.setItem('degreelog-theme', next); }catch(e){}
  syncThemeButton();
});

/* ---------- boot ---------- */
syncThemeButton();
function boot(){
  if(!loadSaved()) renderColumn();
  undoStack = []; lastState = JSON.stringify(snapshot()); updateUndoBtn();   // history starts fresh each visit
}
boot();
