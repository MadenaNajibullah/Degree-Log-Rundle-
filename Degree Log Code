const SHEET_COLORS = {MAND:'#111', FIELD:'#663C1C', GOPH:'#393F9D', HYDRO:'#266EA4', SOFT:'#936E03', HARD:'#A7463C', STRUCT:'#7955A0', PALEO:'#CB6620', GEOCHEM:'#087970', GEOG:'#4C7A2A', RESEARCH:'#9D437F', OTHER:'#555'};
const SHEET_NAMES  = {GEOCHEM:'Geochemistry', GEOG:'Geography', GOPH:'Geophysics', HARD:'Hard Rock', HYDRO:'Hydrogeology', PALEO:'Paleontology', SOFT:'Soft Rock', STRUCT:'Structural', RESEARCH:'Independent Research', OTHER:'Other'};

function sheetCategory(e){
  if(MANDATORY_ALL.has(e.code)) return 'MAND';
  if(FIELD_CODES.indexOf(e.code) !== -1) return 'FIELD';
  return SHEET_COLORS[e.track] ? e.track : 'MAND';
}

function planYearData(){
  return YEAR_ORDER.filter(y => !isBridgeYear(y) && !deletedYears.has(y)).map(y => {
    if(skippedYears.has(y)) return {y, skipped:true, terms:{}};
    const termItems = (yy, t) => {
      const items = (plan[slotKey(yy,t)] || []).map(e => ({
        code: codeLabel(e.code), title: (COURSES[e.code] || {}).name || '',
        cat: sheetCategory(e), prereq: e.source === 'auto-prereq'
      }));
      ensureOptionSlot(yy, t).forEach(s => items.push({
        text: s.value.trim() || 'Open Option'
      }));
      return items;
    };
    const terms = {fall: termItems(y,'fall'), winter: termItems(y,'winter')};
    ['spring','summer'].forEach(t => { if(addedTerms.has(slotKey(y+'s', t))) terms[t] = termItems(y+'s', t); });
    return {y, terms};
  });
}

function buildPlanSheet(){
  const years = planYearData();
  const n = years.length;
