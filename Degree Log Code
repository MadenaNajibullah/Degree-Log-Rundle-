// Pick the layout width that lets the whole sheet be scaled up the most while still
// fitting on a single landscape page (smaller of Letter / A4 each way, 10mm margins).
function fitSheetToOnePage(doc){
  const fit = doc.getElementById('fit');
  if(!fit) return;
  const AW = 980, AH = 718;
  const cols = doc.querySelectorAll('.hd').length || 1;
  let best = {s:0, w:1232};
  fit.style.zoom = 1;
  for(let w = Math.max(cols*210 + 4, 800); w <= 1600; w += 40){
    fit.style.width = w + 'px';
    const s = Math.min(AW / w, AH / fit.offsetHeight, 1);
    if(s > best.s + 1e-6) best = {s, w};
  }
  fit.style.width = best.w + 'px';
  fit.style.zoom = (best.s * 0.97).toFixed(4);
}

function downloadPlanSheet(){
  const frame = document.createElement('iframe');
  frame.setAttribute('aria-hidden', 'true');
  frame.style.cssText = 'position:fixed;left:-10000px;top:0;width:1280px;height:800px;border:0';
  document.body.appendChild(frame);

  const doc = frame.contentDocument;
  doc.open(); doc.write(buildPlanSheet()); doc.close();

  // Browsers suggest the page title as the PDF filename.
  const oldTitle = document.title;
  document.title = 'Degree Log';
  doc.title = 'Degree Log';

  const cleanup = () => { document.title = oldTitle; frame.remove(); };
  frame.contentWindow.addEventListener('afterprint', cleanup);

  // Wait for the web fonts so the PDF doesn't use fallbacks (max 1.5 s).
  const fontsReady = doc.fonts && doc.fonts.ready ? doc.fonts.ready : Promise.resolve();
  Promise.race([fontsReady, new Promise(r => setTimeout(r, 1500))]).then(() => {
    setTimeout(() => {
      try{ fitSheetToOnePage(doc); frame.contentWindow.focus(); frame.contentWindow.print(); }
      catch(e){ cleanup(); }
    }, 150);
  });
}

/* ======================= save, progress, move ======================= */

/* ---------- autosave (this browser only) ---------- */
const STORE_KEY = 'degreelog-plan-v1';
const snapshot = () => ({v:1, plan, skippedStash, skippedYears:[...skippedYears], deletedYears:[...deletedYears], addedTerms:[...addedTerms], optionSlots, slotIdCounter, extraYearCount});
// Undo: every change that reaches persist() pushes the state it replaced. Typing in an open-option box updates the
// current state without making a step of its own, so one undo reverts the whole edit, not one letter.
let undoStack = [], lastState = null, undoing = false;
const UNDO_MAX = 60;
function updateUndoBtn(){
  const b = document.getElementById('undoBtn');
  if(b){ b.disabled = !undoStack.length; b.title = undoStack.length ? 'Undo the last change (Ctrl/Cmd+Z)' : 'Nothing to undo'; }
}
function persist(typing){
  let cur = null;
  try{ cur = JSON.stringify(snapshot()); localStorage.setItem(STORE_KEY, cur); }catch(e){}
  if(cur && !undoing){
    if(lastState !== null && cur !== lastState && typing !== true){
      undoStack.push(lastState);
      if(undoStack.length > UNDO_MAX) undoStack.shift();
    }
    lastState = cur;
  }
  updateUndoBtn();
}
function undoLast(){
  if(!undoStack.length) return;
  const prev = undoStack.pop();
  undoing = true;
  try{ chooserOpen.clear(); closeDrawer(); restoreSnapshot(JSON.parse(prev)); }
  finally{ undoing = false; }
  lastState = prev;
  try{ localStorage.setItem(STORE_KEY, prev); }catch(e){}
