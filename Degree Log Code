<script>
  // Theme: saved choice, else the system setting.
  (function(){
    var t = null;
    try{ t = localStorage.getItem('degreelog-theme') || localStorage.getItem('corelog-theme'); }catch(e){}
    if(t!=='light' && t!=='dark'){
      t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', t);
  })();
  // Side panel width: saved choice, else a roomier default that uses the spare space beside the 920px column.
  (function(){
    var w = null;
    try{ w = parseInt(localStorage.getItem('degreelog-panel-w'), 10); }catch(e){}
    var max = Math.max(300, Math.min(720, window.innerWidth - 480));
    if(!(w > 0)) w = Math.max(340, Math.min(560, window.innerWidth - 1000));
    document.documentElement.style.setProperty('--tr-w', Math.max(300, Math.min(max, w)) + 'px');
  })();
</script>
