// Requirements from the Geology (Fall 2026) program sequencing guide. Each group is one requirement; any member satisfies it.
const REQ_GROUPS = [
  ...MANDATORY_ERTH.filter(c => canon(c) === c).map(groupOf),
  ["MATH249","MATH265"], ["MATH211"], ["CHEM201","CHEM206"], ["CHEM203","CHEM204"], ["PHYS211","PHYS221"],
  ["CPSC217"], ["GEOG380"], ["SCIE311"], ["STAT327","STAT321"]
];
const SCI_TARGET = 6;   // Science Options required (units)
const RESEARCH_CODES = ["ERTH570","ERTH580A","ERTH580B"];
const GGE_SUBJECTS = new Set(['ERTH','GEOG','PHYS','ENGG','ENCH','ENEL','ENSF','ENDG','ENMC','ENCI','ENPE','ENSE','ENCM']);
const unitsOf = c => COURSES[c]?.units || 3;
let trackerTab = 'geo';      // 'geo' | 'hon' | 'res'
let trackerSub = 'info';     // 'info' | 'tracker' (not used on Resources)

/* ---------- 200-level (junior) unit limit: 54 U ---------- */
const JUNIOR_MAX = 54;
// A typed-in course counts as 200-level when it looks like "HIST 201" / "PSYC201".
const isJuniorText = text => { const m = String(text || '').match(/[A-Za-z]{2,6}\s*-?\s*(\d{3})(?!\d)/); return !!m && Math.floor(parseInt(m[1], 10) / 100) === 2; };
function juniorUnitsNow(skipSlotId){
  let n = [...sheetCodes()].filter(c => levelOf(c) === 200).reduce((a, c) => a + unitsOf(c), 0);
  REQ_GROUPS.forEach(g => { if(!g.some(isAnywhereOnSheet) && g.some(completedElsewhere) && levelOf(g[0]) === 200) n += 3; });
  Object.values(optionSlots).flat().forEach(sl => { if(sl.id !== skipSlotId && isJuniorText(sl.value)) n += slotUnits(sl); });
  return n;
}
const juniorMsg = what => `Can’t add <b>${what}</b>: it would take you over the ${JUNIOR_MAX} U limit on 200-level courses.`;

function overflow(list, cap){
  let used = 0;
  const out = [];
  list.forEach(x => {
    if(used + x.u > cap) out.push(x.n);   // this course goes past the cap
    used += x.u;
  });
  return out;
}

function trackerStats(){
  const codes = Object.values(plan).flat().map(e => e.code);   // repeated courses appear once per copy
  const has = c => codes.indexOf(c) !== -1;
  const req = REQ_GROUPS.map(g => ({
    label: g.map(codeLabel).join(' / '),
    done: g.some(c => isAnywhereOnSheet(c) || completedElsewhere(c)),
    elsewhere: !g.some(isAnywhereOnSheet) && g.some(completedElsewhere),
    level: levelOf(g[0]),
    units: unitsOf(g[0])
  }));
  const slots = Object.values(optionSlots).flat().filter(sl => sl.value.trim() || slotUnits(sl) > 0);
  const slotSum = cat => slots.filter(sl => slotCat(sl) === cat).reduce((n, sl) => n + slotUnits(sl), 0);
  const noUnits = slots.filter(sl => slotUnits(sl) === 0).length;
  // GGE options: 6 U from Earth, Engineering, Geography or Physics. Eligible courses count toward the
  // other requirements first (science, non-major field, open); only what those can't absorb goes to GGE.
  const gSubj = text => { const m = String(text || '').trim().match(/^([A-Za-z]{2,6})\s*-?\s*\d{3}/); return m ? m[1].toUpperCase() : ''; };
  const isGgeText = text => GGE_SUBJECTS.has(gSubj(text));
  // Field of Geoscience courses: ERTH 300+ (listed first) and the optional GEOG courses.
  const isFieldCourse = c => !MANDATORY_ALL.has(c) && levelOf(c) >= 300 && (subjectOf(c) === 'ERTH' || subjectOf(c) === 'GEOG');
  const fieldAll = [...codes.filter(c => isFieldCourse(c) && subjectOf(c) === 'ERTH'), ...codes.filter(c => isFieldCourse(c) && subjectOf(c) === 'GEOG')];
  const honView = trackerTab === 'hon';
  // Senior research is its own requirement: the research courses, and the 500-level course taken with ERTH 570,
  // are kept out of the Field counts below (Honours only). The partner course only has to exist; it still counts as a Field course.
  const bothResearch = has('ERTH580A') && has('ERTH580B');
  const researchPartner = has('ERTH570') && !bothResearch ? fieldAll.find(c => levelOf(c) >= 500 && RESEARCH_CODES.indexOf(c) === -1) : undefined;
  const researchUsed = new Set(honView ? RESEARCH_CODES.filter(has) : []);   // research courses only; the ERTH 570 partner stays a 500-level Field course
  const fieldNow = fieldAll.filter(c => !researchUsed.has(c));
  const openCap = honView ? 15 : 18;
  // B.Sc.: the first 3 500-level Field courses fill their own 3 slots; any further 500-level courses then count
  // toward the 3 courses at 300+ level, along with the 300/400-level ones (6 courses in all).
  // Honours works the same way with 5 courses at 300+ level plus 1 500-level one (6 in all).
  const n500 = honView ? 1 : 3;   // Honours needs only 1 separate 500-level Field course (3 U); senior research covers the rest
  const fieldHigh = fieldNow.filter(c => levelOf(c) >= 500);
  const field300 = [...fieldNow.filter(c => levelOf(c) < 500), ...fieldHigh.slice(n500)];
  const fieldOver = field300.slice(honView ? 5 : 3);   // Field courses past the requirement
  // Extra Geography courses fill the Arts requirement (6 U) once the Field requirement is full.
  const geogOver = fieldOver.filter(c => subjectOf(c) === 'GEOG').reduce((n, c) => n + unitsOf(c), 0);
  const geogArts = Math.min(geogOver, Math.max(0, 6 - slotSum('arts')));
  const geogLeft = geogOver - geogArts;  const nonsciNow = slotSum('nonsci') + slotSum('arts') + geogArts;
  let sciBase = 0, openBase = 0;
  const nm = {sci:[], nonsci:[], arts:[], gge:[], open:[]};   // {n:name, u:units} for each bucket
  const add = (k, n, u) => { if(u > 0) nm[k].push({n, u}); };
  const slotName = sl => sl.value.trim() || SLOT_CATS[slotCat(sl)];
  slots.forEach(sl => {
    const c = slotCat(sl), u = slotUnits(sl);
    if(c === 'nonsci') add('nonsci', slotName(sl), u);
    if(c === 'arts'){ add('arts', slotName(sl), u); if(u > 0) nm.nonsci.push({n:slotName(sl), u, a:true}); }
  });
  { let rem = geogArts;
    fieldOver.filter(c => subjectOf(c) === 'GEOG').forEach(c => { const t = Math.min(rem, unitsOf(c)); rem -= t; add('arts', codeLabel(c), t); if(t > 0) nm.nonsci.push({n:codeLabel(c), u:t, a:true}); }); }
  const ggeDirectList = [];
  const ggeItems = [];   // eligible courses: {units, kind:'science'|'open'}
  let ggeDirect = 0;     // options explicitly tagged GGE
  codes.filter(c => !MANDATORY_ALL.has(c)).forEach(c => {
    const subj = subjectOf(c);
    if(fieldNow.indexOf(c) !== -1 || researchUsed.has(c)) return;   // Field course (extras handled below) or senior research
    if(GGE_SUBJECTS.has(subj)) ggeItems.push({units:unitsOf(c), kind:(subj === 'ERTH' || subj === 'GEOG') ? 'open' : 'science', name:codeLabel(c)});
    else if(subj !== 'ERTH' && subj !== 'GEOG'){ sciBase += unitsOf(c); add('sci', codeLabel(c), unitsOf(c)); }
  });
  // Geoscience courses past the Field requirement fill GGE first, then Open options.
  // Each repeated copy of a course is its own class, so extra copies get their own name ("ERTH 590 (copy 2)") in the lists.
  const seenCopies = {};
  const copyName = c => { const n = (seenCopies[c] = (seenCopies[c] || 0) + 1); return n > 1 ? `${codeLabel(c)} (copy ${n})` : codeLabel(c); };
  fieldOver.filter(c => subjectOf(c) === 'ERTH').forEach(c => ggeItems.push({units:unitsOf(c), kind:'geo', name:copyName(c)}));
  // Honours: repeated copies of a senior research course beyond the first one don't count as research; they fill GGE / Open options.
  if(honView) RESEARCH_CODES.forEach(c => { for(let i = 1; i < codes.filter(x => x === c).length; i++) ggeItems.push({units:unitsOf(c), kind:'geo', name:copyName(c)}); });
  { let rem = geogArts;
    fieldOver.filter(c => subjectOf(c) === 'GEOG').forEach(c => { const t = Math.min(rem, unitsOf(c)); rem -= t; if(unitsOf(c) - t > 0) ggeItems.push({units:unitsOf(c) - t, kind:'geo', name:codeLabel(c)}); }); }   // Geography beyond the Arts requirement
  slots.forEach(sl => {
    const cat = slotCat(sl), u = slotUnits(sl);
    if(cat === 'gge'){ ggeDirect += u; ggeDirectList.push({u, n:slotName(sl)}); }
    else if((cat === 'science' || cat === 'open') && isGgeText(sl.value)) ggeItems.push({units:u, kind:cat, name:slotName(sl)});
    else if(cat === 'science'){ sciBase += u; add('sci', slotName(sl), u); }
    else if(cat === 'open'){ openBase += u; add('open', slotName(sl), u); }
  });
  let ggeLeft = 6, gge = 0, sciUnits = sciBase, openFall = openBase;
  const toGge = (u, name) => { const t = Math.min(ggeLeft, u); ggeLeft -= t; gge += t; add('gge', name, t); return u - t; };
  ggeDirectList.forEach(d => { const r = toGge(d.u, d.n); openFall += r; add('open', d.n, r); });   // tagged GGE options fill GGE directly
  let sciSpace = Math.max(0, SCI_TARGET - sciBase);
  let nmSpace = honView ? 0 : Math.max(0, 3 - Math.max(0, sciBase - SCI_TARGET) - Math.max(0, nonsciNow - 15));
  let openSpace = Math.max(0, openCap - openBase);
  ggeItems.forEach(it => {
    let u = it.units;
    if(it.kind === 'science'){
      const s1 = Math.min(sciSpace, u); sciSpace -= s1; u -= s1; sciUnits += s1; add('sci', it.name, s1);
      const s2 = Math.min(nmSpace, u); nmSpace -= s2; u -= s2; sciUnits += s2; add('sci', it.name, s2);
      const r = toGge(u, it.name); openFall += r; add('open', it.name, r);
    }else if(it.kind === 'geo'){
      u = toGge(u, it.name);
      openFall += u; add('open', it.name, u);   // past GGE everything else counts in Open options
    }else{
      const o1 = Math.min(openSpace, u); openSpace -= o1; u -= o1; openFall += o1; add('open', it.name, o1);
      const r = toGge(u, it.name); openFall += r; add('open', it.name, r);
    }
  });
  let arts = slotSum('arts') + geogArts;   // Arts units also count toward the 15 U
  // Each unit is listed in exactly one place. Science fills its 6 U, then the non-major field option (3 U, B.Sc. only);
  // non-science fills its 15 U, then whatever room is left in the non-major option; anything past that goes to Open options.
  let nmLeft = honView ? 0 : 3;
  const place = (list, cap) => {
    let used = 0; const kept = [], toNm = [], toOpen = [];
    list.forEach(x => {
      const keep = Math.max(0, Math.min(x.u, cap - used));
      used += x.u;
      if(keep > 0) kept.push({n:x.n, u:keep, a:x.a});
      let over = x.u - keep;
      const n = Math.min(nmLeft, over); nmLeft -= n; over -= n;
      if(n > 0) toNm.push({n:x.n, u:n});
      if(over > 0) toOpen.push({n:x.n, u:over});
    });
    return {kept, toNm, toOpen};
  };
  const sumU = l => l.reduce((n, x) => n + x.u, 0);
  const sciP = place(nm.sci, SCI_TARGET), nsP = place(nm.nonsci, 15);
  nm.sci = sciP.kept; nm.nonsci = nsP.kept;
  nm.arts = nsP.kept.filter(x => x.a);   // only Arts units that actually count within the 15 U are listed under Arts
  arts = sumU(nm.arts);
  [...sciP.toOpen, ...nsP.toOpen].forEach(x => { add('open', x.n, x.u); openFall += x.u; });
  sciUnits = sumU(sciP.kept);
  const nonsci = sumU(nsP.kept);
  const nmItems = [...sciP.toNm, ...nsP.toNm];
  const nonMajor = sumU(nmItems);
  const optUnits = slots.reduce((n, sl) => n + slotUnits(sl), 0);
  const skippedCount = [...skippedYears].filter(y => typeof y === 'number' && !deletedYears.has(y)).length;
  const units = codes.reduce((n, c) => n + unitsOf(c), 0) + optUnits + skippedCount * 30;
  const junior = juniorUnitsNow();
  const uniq = a => [...new Set(a)];
  // one entry per course, with the units it contributes to this requirement, e.g. "PHYS 223 (3 U)"
  const names = k => {
    const sums = new Map();
    nm[k].forEach(x => sums.set(x.n, (sums.get(x.n) || 0) + x.u));
    return [...sums].map(([n, u]) => `${n} (${u} U)`);
  };

  const juniorList = [
    ...codes.filter(c => levelOf(c) === 200).map(codeLabel),
    ...REQ_GROUPS.filter(g => !g.some(isAnywhereOnSheet) && g.some(completedElsewhere) && levelOf(g[0]) === 200).map(g => g.map(codeLabel).join(' / ') + ' (year marked completed)'),
    ...Object.values(optionSlots).flat().filter(sl => isJuniorText(sl.value)).map(sl => sl.value.trim())
  ];
  const reqTaken = REQ_GROUPS.flatMap(g => g.filter(c => isAnywhereOnSheet(c) || completedElsewhere(c)).map(c => isAnywhereOnSheet(c) ? codeLabel(c) : codeLabel(c) + ' (year marked completed)'));
  const totalList = [
    ...codes.map(codeLabel),
    ...slots.filter(sl => slotUnits(sl) > 0).map(sl => `${slotName(sl)} (${slotUnits(sl)} U)`),
    ...(skippedCount ? [`${skippedCount} completed year${skippedCount === 1 ? '' : 's'} (30 U each)`] : [])
  ];
  const field = field300.slice(0, honView ? 5 : 3);   // extras past the requirement are listed under the option that absorbs them
  const field500 = fieldHigh.slice(0, n500);
  let research = null;
  if(bothResearch) research = 'ERTH 580A + 580B (6U)';
  else if(researchPartner) research = `ERTH 570 + ${codeLabel(researchPartner)} (6U)`;
  const researchCourses = bothResearch ? 2 : has('ERTH570') ? 1 + (researchPartner ? 1 : 0) : (has('ERTH580A') || has('ERTH580B') ? 1 : 0);
  const researchUnits = bothResearch ? 6 : has('ERTH570') ? 3 + (researchPartner ? 3 : 0) : (has('ERTH580A') || has('ERTH580B') ? 3 : 0);
  const lists = {sci:names('sci'), nonsci:names('nonsci'), arts:names('arts'), gge:names('gge'), open:names('open'), nonMajor:(() => { const m = new Map(); nmItems.forEach(x => m.set(x.n, (m.get(x.n) || 0) + x.u)); return [...m].map(([n, u]) => `${n} (${u} U)`); })(), junior:juniorList, req:reqTaken, total:totalList, research:codes.filter(c => RESEARCH_CODES.indexOf(c) !== -1).map(codeLabel)};
  return {lists, req, reqDone:req.filter(r => r.done).length, units, junior, field, field500, research, has, sciPlanned:codes.filter(c => !MANDATORY_ALL.has(c) && !GGE_SUBJECTS.has(subjectOf(c))), sciUnits, nonsci, arts, nonMajor, gge, open:openFall, noUnits,
    courses: codes.length + slots.filter(sl => slotUnits(sl) > 0).length + skippedCount * 10,   // completed years counted as 10 courses (30 U) each
    researchCourses, researchUnits, fieldUnits: field.reduce((n, c) => n + unitsOf(c), 0), field500Units: field500.reduce((n, c) => n + unitsOf(c), 0),
    reqUnits: req.filter(r => r.done).reduce((n, r) => n + r.units, 0), reqUnitsTotal: req.reduce((n, r) => n + r.units, 0),
    extraGeo:fieldOver.length, extraHon:fieldOver.length};   // Field courses past the requirement
}

const trUse = (names, none = 'None yet.') => `<p class="tr-note">${names.length ? '<b>Made up of:</b> ' + names.map(escHtml).join(', ') + '.' : none}</p>`;
