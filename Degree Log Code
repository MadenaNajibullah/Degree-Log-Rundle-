<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Degree Log — Geoscience Degree Sequencing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
  /* ---------- tokens ---------- */
  :root{
    color-scheme:light;
    --paper:#fff; --paper-deep:#f1f1f1;
    --ink:#111; --ink-soft:#555;
    --line:rgba(17,17,17,.22); --line-soft:rgba(17,17,17,.12);
    --goph:#393F9D; --hydro:#266EA4; --soft:#936E03; --hard:#A7463C; --geochem:#087970; --struct:#7955A0; --paleo:#CB6620; --research:#9D437F; --fieldschool:#663C1C; --geog:#4C7A2A; --other:#6B6B6B;
    --accent:var(--ink-soft);
    --serif:'Spectral',serif; --mono:'IBM Plex Mono',monospace; --sans:'Public Sans',sans-serif;
  }
  :root[data-theme="dark"]{
    color-scheme:dark;
    --paper:#141414; --paper-deep:#232323;
    --ink:#EDEDED; --ink-soft:#A3A3A3;
    --line:rgba(237,237,237,.25); --line-soft:rgba(237,237,237,.13);
    --goph:#8F9EEF; --hydro:#72B8F2; --soft:#D4AB4F; --hard:#F98F82; --geochem:#5CC6B9; --struct:#C39DEE; --paleo:#F7A062; --research:#ED8BCA; --fieldschool:#B08060; --geog:#9CCB6A; --other:#9A9A9A;
  }

  /* ---------- base ---------- */
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--paper); color:var(--ink); font-family:var(--sans);
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  }
  button{font:inherit;color:inherit}
  .stripes{ /* hatched fill used by locked chips and the legend */
    background-image:repeating-linear-gradient(45deg,color-mix(in srgb,var(--ink) 8%,transparent) 0 4px,transparent 4px 8px);
  }

  /* ---------- header ---------- */
  header,main,.legend{max-width:920px;margin:0 auto}
  .site-mark{
    display:inline-block; font:12px var(--mono); letter-spacing:.02em;
    color:var(--ink-soft); border:1px solid var(--line); padding:2px 7px; border-radius:2px;
  }
  .planning-note{font-size:12.5px;line-height:1.5;color:var(--ink-soft);max-width:64ch}
  .planning-note p{margin:4px 0 0}
  .planning-note strong{color:var(--ink)}

  main{padding:14px 28px 120px}
  .legend{padding:0 28px 60px;font-size:12.5px;color:var(--ink-soft);display:flex;flex-wrap:wrap;gap:18px}
  .legend span{display:flex;align-items:center;gap:7px}
  .legend i{width:16px;height:11px;border-radius:2px;display:inline-block}
  .li1{border:1px solid var(--ink);background:var(--paper)}
  .li2{border:1px solid var(--goph);background:color-mix(in srgb,var(--goph) 16%,transparent)}
  .li3{border:1px solid var(--ink-soft);background:var(--paper-deep);opacity:.82}
  .li4{border:1px dotted var(--ink-soft)}
  .li5{border:1px solid var(--ink)}

  /* ---------- the column ---------- */
  .depth-note{font:11px var(--mono);letter-spacing:.02em;color:var(--ink-soft);margin:0 0 10px 46px;opacity:.7}
  
  #column{display:flex;flex-direction:column-reverse;border-left:2px solid var(--ink);margin-left:46px;position:relative}

  .stratum:first-child{border-bottom:none}
  .tick{
    position:absolute;left:-2px;top:26px;width:9px;height:9px;
    background:var(--paper);border:2px solid var(--ink);border-radius:50%;
  }
  .add-tick{border:2px dashed var(--ink-soft)}
  .yr-tag{
    position:absolute;left:-64px;top:22px;width:46px;text-align:right;
    font:600 15px var(--serif);
  }

  .year-toggle{
    position:absolute;right:0;top:20px;width:22px;height:22px;border-radius:50%;
    border:1px solid var(--line);background:transparent;color:var(--ink-soft);
    font-size:15px;line-height:1;cursor:pointer;
  }
  .year-toggle:hover{border-color:var(--ink);color:var(--ink);background:var(--paper-deep)}

  .stratum.skipped{padding:14px 0 14px 30px;opacity:.7}
  .stratum.skipped .yr-tag{top:14px}
  .skip-note{margin:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .restore-btn{font:11.5px var(--mono);padding:5px 10px;border:1px solid var(--ink-soft);background:transparent;border-radius:2px;cursor:pointer}
  .restore-btn:hover{background:var(--paper-deep)}

  /* unexcavated (empty) years fold down to a thin strip */
  .stratum.collapsed{padding:12px 0 12px 30px}
  .stratum.collapsed .tick{top:16px;border-style:dashed;border-color:var(--ink-soft)}
  .stratum.collapsed .yr-tag{top:12px;font-size:13px;color:var(--ink-soft)}
  .stratum.collapsed .stratum-label{margin:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap}

  /* first-visit prompt inside an empty Year 1 */
  .start-prompt{margin:-4px 0 18px}
  .start-prompt .stratum-label{color:var(--ink);margin-bottom:10px}

  .disc-toggle{font:11.5px var(--mono);border:none;background:none;color:var(--ink);text-decoration:underline;cursor:pointer;padding:0 2px}
  .datum-base{margin-top:0;padding-top:8px;border-top:2px solid var(--ink)}

  .bridge-slim{padding:10px 0 10px 30px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .bridge-slim .add-tick{top:15px}
  .bridge-slim-text{font:11px var(--mono);letter-spacing:.02em;color:var(--ink-soft)}
  .add-year-row{display:flex;align-items:center;gap:10px;padding:18px 0 10px 30px;border-bottom:none;flex-wrap:wrap}
  .add-year-row .add-tick{top:22px}
  .remove-year-btn{color:var(--hard);border-color:var(--hard);background:color-mix(in srgb,var(--hard) 10%,transparent)}

  /* ---------- terms ---------- */
  .terms-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;align-items:start}
  .term-block{margin-bottom:16px}
  .term-block:last-child{margin-bottom:0}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;align-items:center}
  .chips:last-child{margin-bottom:0}
  .slot-controls{margin-top:2px}
  .elective-head{font:11px var(--mono);letter-spacing:.02em;color:var(--accent);margin:10px 0 8px;display:none;align-items:center;gap:6px}
  .elective-head::before{content:"";width:14px;height:1px;background:var(--accent)}

  /* ---------- chips ---------- */
  .chip{
    font:12.5px var(--mono);padding:6px 10px;border:1px solid var(--ink);border-radius:2px;
    cursor:pointer;background:var(--paper);color:var(--ink);
    transition:transform .1s ease,background .15s ease;
  }
  .chip:disabled{cursor:default;opacity:.55;transform:none}
  .chip.locked{cursor:not-allowed}
  .chip.locked:disabled{opacity:.4}
  /* unavailable picker courses stay clickable so their reason can be read */
  .chip[aria-disabled="true"]{cursor:default;opacity:.55}
  .chip.locked[aria-disabled="true"]{cursor:not-allowed;opacity:.4}
  .chip{touch-action:manipulation}   /* no double-tap zoom on courses */
  .chip.previewing{outline:2px solid var(--ink);outline-offset:2px}
  .picker-preview{flex:0 0 100%;box-sizing:border-box;margin:2px 0 4px;padding:12px 14px;background:var(--paper-deep);border:1px solid var(--line);border-radius:3px;font-size:12.5px;line-height:1.5}
  .picker-preview b{display:block;font:600 14px var(--serif);margin-bottom:2px}
  .picker-preview .pp-status{display:block;font:11.5px var(--mono);color:var(--ink-soft);margin-bottom:6px}
  .picker-preview p{margin:0}
  .picker-preview .pp-prereq{margin-top:8px;font-size:12px;color:var(--ink-soft)}
  .picker-preview .pp-prereq b{display:inline;font:600 12px var(--sans);margin:0;color:var(--ink)}

  /* one colour per track, set via --c; mandatory/field chips keep the plain ink style */
  .tt-OTHER{--c:var(--other)} .tt-GEOG{--c:var(--geog)} .tt-GOPH{--c:var(--goph)} .tt-HYDRO{--c:var(--hydro)} .tt-SOFT{--c:var(--soft)} .tt-HARD{--c:var(--hard)} .tt-GEOCHEM{--c:var(--geochem)} .tt-STRUCT{--c:var(--struct)} .tt-PALEO{--c:var(--paleo)} .tt-RESEARCH{--c:var(--research)}
  .chip-track-OTHER,.chip-track-GEOG,.chip-track-GOPH,.chip-track-HYDRO,.chip-track-SOFT,.chip-track-HARD,.chip-track-GEOCHEM,.chip-track-STRUCT,.chip-track-PALEO,.chip-track-RESEARCH{
    border-color:var(--c);background:color-mix(in srgb,var(--c) 16%,transparent);
  }
  .chip-track-OTHER{--c:var(--other)} .chip-track-GEOG{--c:var(--geog)} .chip-track-GOPH{--c:var(--goph)} .chip-track-HYDRO{--c:var(--hydro)}
  .chip-track-SOFT{--c:var(--soft)} .chip-track-HARD{--c:var(--hard)} .chip-track-GEOCHEM{--c:var(--geochem)} .chip-track-STRUCT{--c:var(--struct)} .chip-track-PALEO{--c:var(--paleo)} .chip-track-RESEARCH{--c:var(--research)}
  .tag{font-size:9px;text-transform:uppercase;letter-spacing:.03em;opacity:.65;margin-right:5px}

  .elective-wrap{display:inline-flex;align-items:center;gap:3px;cursor:grab}
  .elective-wrap:active{cursor:grabbing}
  .elective-chips.drop-hover{outline:2px dashed var(--accent);outline-offset:4px;border-radius:4px}
  .chip-x{
    border:1px solid var(--line);background:transparent;color:var(--ink-soft);
    width:20px;height:20px;line-height:1;border-radius:50%;cursor:pointer;font-size:12px;padding:0;
  }
  .chip-x:hover{border-color:var(--ink);color:var(--ink)}
  .add-option{font-size:11.5px;padding:4px 9px;opacity:.8}
  .add-option:hover{opacity:1}

  .slot-wrap{display:inline-flex;align-items:center;gap:4px;flex-wrap:wrap}
  .slot-input{
    font:italic 12.5px var(--sans);color:var(--ink);border:1px dotted var(--ink-soft);
    background:transparent;padding:6px 10px;border-radius:2px;min-width:150px;
  }
  .slot-input::placeholder{color:var(--ink-soft);opacity:.65}
  .slot-input:focus{outline:none;border-style:solid;border-color:var(--accent)}

  /* ---------- course picker ---------- */
  #pickerOverlay,#moveOverlay,#warnOverlay,#semOverlay{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;align-items:center;justify-content:center;z-index:30;padding:20px}
  #pickerOverlay.open,#moveOverlay.open,#warnOverlay.open,#semOverlay.open{display:flex}
  #pickerCard,#moveCard,#warnCard,#semCard{
    background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:24px 26px;
    width:100%;max-width:560px;max-height:80vh;overflow-y:auto;position:relative;
  }
  .close{
    position:absolute;top:14px;right:14px;width:26px;height:26px;cursor:pointer;
    background:transparent;border:1px solid var(--line);border-radius:2px;
  }
  .picker-title{font:17px var(--serif);margin:0 0 14px;padding-right:34px}
  .picker-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
  .picker-tab-btn{font:12.5px var(--mono);padding:7px 12px;border:1px solid var(--line);background:transparent;border-radius:2px;cursor:pointer;color:var(--ink-soft)}
  .picker-tab-btn.active{background:var(--c,var(--ink));border-color:var(--c,var(--ink));color:var(--paper)}
  .warn-text{font-size:13.5px;line-height:1.5;margin:0 0 10px}
  #warnCard .chips{margin:16px 0 0}
  #warnCard .remove-year-btn{color:var(--hard);border-color:var(--hard)}

  #toast{
    position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);opacity:0;pointer-events:none;
    z-index:40;max-width:min(560px,calc(100vw - 32px));display:flex;gap:12px;align-items:flex-start;
    background:var(--ink);color:var(--paper);padding:12px 14px;border-radius:4px;
    font-size:13px;line-height:1.45;box-shadow:0 6px 24px rgba(0,0,0,.25);
    transition:opacity .2s ease,transform .2s ease;
  }
  #toast.show{opacity:1;transform:translateX(-50%);pointer-events:auto}
  #toast button{background:none;border:1px solid color-mix(in srgb,var(--paper) 40%,transparent);color:var(--paper);width:22px;height:22px;border-radius:50%;cursor:pointer;flex:0 0 auto;padding:0;line-height:1}
  @media (max-width:760px){#toast{bottom:76px}}
  @media (prefers-reduced-motion:reduce){#toast{transition:none}}
  .picker-empty{font-size:13px;color:var(--ink-soft);font-style:italic;margin:0}
  .picker-hint{font-size:11.5px;color:var(--ink-soft);margin:14px 0 0;line-height:1.5}
  .picker-hint .hint-title{
    display:block;font:10.5px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);
    margin:0 0 8px;padding-bottom:4px;border-bottom:1px solid var(--line-soft);
  }
  .picker-hint ul{margin:0;padding-left:16px}
  .picker-hint li{margin:0 0 4px}
  .picker-hint li:last-child{margin-bottom:0}
  .picker-level-group{margin-bottom:14px}
  .picker-level-group:last-child{margin-bottom:0}
  .picker-level-head{
    font:10.5px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);
    margin:0 0 6px;padding-bottom:4px;border-bottom:1px solid var(--line-soft);
  }

  /* ---------- course drawer ---------- */
  #drawer{
    position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:var(--paper);
    transform:translateY(100%);transition:transform .22s ease;z-index:20;
    padding:22px 28px calc(26px + env(safe-area-inset-bottom,0px));
    border-top:1px solid var(--accent);max-height:70vh;overflow-y:auto;
  }
  #drawer.open{transform:translateY(0)}
  #drawer .wrap{max-width:920px;margin:0 auto;position:relative}
  #drawer .close{top:0;right:0;width:28px;height:28px;border-color:color-mix(in srgb,var(--paper) 40%,transparent);color:var(--paper);font-size:15px}
  #drawer h3{font:22px var(--serif);margin:0 0 2px}
  .d-nav{display:flex;align-items:center;gap:6px;margin:0 0 8px;min-height:28px}
  .d-nav button{width:28px;height:28px;border:1px solid color-mix(in srgb,var(--paper) 40%,transparent);background:transparent;color:var(--paper);font-size:16px;line-height:1;cursor:pointer;border-radius:0}
  .d-nav button:hover:not(:disabled){background:color-mix(in srgb,var(--paper) 15%,transparent)}
  .d-nav button:disabled{opacity:.3;cursor:default}
  .d-nav span{font:11px var(--mono);opacity:.6;margin-left:4px}
  #drawer .code{font:12px var(--mono);opacity:.7}
  #drawer .d-desc{font-size:13.5px;line-height:1.55;margin:10px 0 0;max-width:72ch;opacity:.9}
  #drawer .d-desc:empty{display:none}
  #drawer .meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-top:16px}
  #drawer .meta b{display:block;font:400 10.5px var(--mono);letter-spacing:.03em;opacity:.55;margin-bottom:4px}
  #drawer .meta span{font-size:13.5px;line-height:1.4}
  button.reflink{
    background:none;border:1px solid color-mix(in srgb,var(--paper) 45%,transparent);
    color:var(--paper);font:12px var(--mono);padding:1px 6px;border-radius:2px;cursor:pointer;margin:0 3px 3px 0;
  }

  /* ---------- theme toggle + side nav ---------- */
  #themeToggle{
    position:fixed;right:16px;top:calc(16px + env(safe-area-inset-top,0px));width:40px;height:40px;
    border-radius:50%;border:1px solid var(--ink);background:var(--paper);color:var(--ink);
    font-size:18px;line-height:1;cursor:pointer;z-index:25;display:flex;align-items:center;justify-content:center;padding:0;
    transition:background .15s ease,color .15s ease;
  }
  #themeToggle:hover{background:var(--ink);color:var(--paper)}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px}

  #sideNav{position:fixed;right:16px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:8px;z-index:15}
  #sideNav button{
    font:11px var(--mono);letter-spacing:.03em;background:var(--paper-deep);border:1px solid var(--ink);
    padding:9px 6px;border-radius:2px;cursor:pointer;writing-mode:vertical-rl;text-orientation:mixed;
    transition:background .15s ease,color .15s ease;
  }
  #sideNav button.bridge{font-style:italic;opacity:.75;border-style:dashed}
  #sideNav button:hover,#sideNav button.active{background:var(--ink);color:var(--paper)}

  /* ---------- tabs, toolbar, progress, move ---------- */
  .tabs{display:flex;gap:6px;flex-wrap:wrap;margin-top:22px}
  .tab{font:12.5px var(--mono);padding:8px 14px;border:1px solid var(--line);border-radius:2px;color:var(--ink-soft);text-decoration:none}
  a.tab:hover{border-color:var(--ink);color:var(--ink)}
  .tab.active{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px 46px;align-items:center}

  .trk{font-size:9px;letter-spacing:.03em;opacity:.65;margin-left:6px}
  #moveList{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px}
  @media (max-width:600px){.toolbar{margin-left:0}}

  /* ---------- responsive / motion / print ---------- */
  @media (max-width:760px){
    #sideNav{
      left:0;right:0;top:auto;bottom:0;transform:none;flex-direction:row;overflow-x:auto;
      background:var(--paper-deep);border-top:1px solid var(--line);
      padding:8px 10px calc(8px + env(safe-area-inset-bottom,0px));gap:6px;
    }
    #sideNav button{writing-mode:horizontal-tb;padding:7px 11px;flex:0 0 auto}
  }
  @media (max-width:600px){
    header,main,.legend{padding-left:16px;padding-right:16px}
    #column{margin-left:34px}
    .depth-note{margin-left:34px}
    .yr-tag{left:-48px;width:34px;font-size:12px}
    .terms-row{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){.chip,#drawer{transition:none}}
  @media print{
    #disc-more{display:inline!important}
    .disc-toggle{display:none}
    :root,:root[data-theme="dark"]{
      --paper:#fff;--paper-deep:#f1f1f1;--ink:#111;--ink-soft:#555;
      --line:rgba(17,17,17,.22);--line-soft:rgba(17,17,17,.12);
      --goph:#808080;--hydro:#3B5B7E;--soft:#A8741F;--hard:#8A3A33;--geochem:#23776D;--struct:#6B4E8C;--paleo:#5E7A2E;--research:#191970;--geog:#3F7D3A;
    }
    .no-print,#pickerOverlay,#toast{display:none!important}
    #column{border-left:1px solid #000}
    .tick{border-color:#000;background:#fff}
    .chip,.slot-input{border-color:#000!important;break-inside:avoid}
    .stratum{break-inside:avoid}
  }

h1{font:600 32px/1.05 var(--serif);margin:12px 0 6px}
h1 em{font-style:italic;font-weight:400;color:var(--ink-soft);font-size:.55em;display:block;margin-top:6px}
header{padding:40px 28px 0}
.text-panel{border-bottom:none;padding-bottom:0}
#sideNav,.legend{display:none}
.stratum{position:relative;padding:28px 0 28px 30px;border-bottom:1px solid var(--line-soft)}
.stratum-label{font:italic 12.5px var(--serif);color:var(--ink-soft);margin:0 0 18px}
.term-name{font:11px var(--mono);background:none;display:inline-block;padding:0;border-radius:2px;margin-bottom:10px;color:var(--ink-soft)}
.chip,
[class*="chip-track-"]{
  background:transparent;
  border:1px solid var(--line);
  border-left:3px solid var(--c, var(--ink));
  font-size:12px;
}
.chip.add-elective,.chip.add-year-btn,.chip.remove-year-btn{border-left-width:1px}
.chip.auto-prereq{opacity:1}
.chip:hover{background:var(--paper-deep);transform:none}
.tag,.trk{display:none}
.elective-wrap .chip-x,.slot-wrap .chip-x,.year-toggle{opacity:.45;transition:opacity .15s ease}
.elective-wrap:hover .chip-x,.elective-wrap:focus-within .chip-x,
.slot-wrap:hover .chip-x,.slot-wrap:focus-within .chip-x,
.stratum:hover .year-toggle,.year-toggle:focus-visible{opacity:1}
@media (hover:none){
  .elective-wrap .chip-x,.slot-wrap .chip-x,.year-toggle{opacity:.7}
}
.add-elective,.add-year-btn{border-style:dashed;border-left-style:dashed;border-left-width:1px;background:transparent;color:var(--ink-soft);opacity:.8}
.add-elective:hover,.add-year-btn:hover{opacity:1}
.toolbar .chip{font-size:12.5px;border:1px solid var(--ink);background:var(--paper);color:var(--ink);opacity:1}
.toolbar .add-elective{border-style:dashed;background:transparent;color:var(--ink-soft)}
.stratum.collapsed .restore-btn{border-style:dashed;border-color:var(--line);color:var(--ink-soft)}
.stratum.collapsed .restore-btn:hover{border-color:var(--ink);color:var(--ink)}

/* track courses: the whole chip carries the track colour */
.chip.chip-track-OTHER,.chip.chip-track-GEOG,.chip.chip-track-GOPH,.chip.chip-track-HYDRO,.chip.chip-track-SOFT,.chip.chip-track-HARD,.chip.chip-track-GEOCHEM,.chip.chip-track-STRUCT,.chip.chip-track-PALEO,.chip.chip-track-RESEARCH{
  background-color:color-mix(in srgb,var(--c) 25%,transparent);
  border-color:var(--c);
}
