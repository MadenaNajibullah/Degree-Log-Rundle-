const chooserOpen = new Set(); // breaks whose "Spring or Summer?" choice is showing
const bridgeHasTerms = y => ['spring','summer'].some(t => addedTerms.has(slotKey(y,t)));
function openBridgeChooser(y){ chooserOpen.add(normYear(y)); renderColumn(); }
function closeBridgeChooser(y){ chooserOpen.delete(normYear(y)); renderColumn(); }
function addBridgeTerm(year, term){
  year = normYear(year);
  addedTerms.add(slotKey(year, term));
  chooserOpen.delete(year);
  renderColumn();
}
function removeBridgeTerm(year, term){
  const k = slotKey(normYear(year), term);
  addedTerms.delete(k);
  delete plan[k];
  delete optionSlots[k]; // re-adding starts fresh
